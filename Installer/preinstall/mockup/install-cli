# Split ONCE, at startup, into parallel arrays — including the lowercased
# haystack the filter matches against. The first version re-split the table
# inside filter(), which is five command substitutions per row per pass:
# ~570 forks for one keystroke. That is imperceptible on the dev box and
# would be visible lag on a 2015 laptop, which is the only kind of machine
# this ever runs on. Parse once; the hot path forks nothing.
CODE=() ENDONYM=() LATIN=() KEYMAP=() LOCALE=() HAY=()
while IFS='|' read -r c e l a k lo; do
  [ -n "$c" ] || continue
  CODE+=("$c"); ENDONYM+=("$e"); LATIN+=("$l"); KEYMAP+=("$k"); LOCALE+=("$lo")
  # Leading space so the filter can ask for "starts a word" with one glob;
  # hyphens become spaces so "es 419" and "pt br" are word starts too.
  h=" $e $l $a $c $lo"; h=${h,,}; HAY+=("${h//-/ }")
done <<<"$LANGUAGES"
NROWS=${#CODE[@]}

f_code()    { printf '%s' "${CODE[$1]}"; }
f_endonym() { printf '%s' "${ENDONYM[$1]}"; }
f_latin()   { printf '%s' "${LATIN[$1]}"; }
f_keymap()  { printf '%s' "${KEYMAP[$1]}"; }
f_locale()  { printf '%s' "${LOCALE[$1]}"; }

# THE SHAPING NOTE (census-mock's KNOWN DEFECT, restated honestly).
# The Linux console has no text shaping: fbcon draws one glyph per code
# point, so Devanagari matras and Arabic joining land as loose marks. On a
# real MiniGolem boot that IS what a stranger sees. This does not break the
# filter — they type "hindi" either way — but the endonym they are looking
# for will not look like itself. So on the bare console the second column
# leads instead. It is census-mock's "way out 1", applied only where the
# terminal actually cannot cope rather than everywhere.
#
# dwidth() below handles the common Indic and Arabic nonspacing marks, not
# every one of them — Tamil and Telugu still land a column out in a shaping
# terminal. Left as is deliberately: the bare console, which is the only
# place a stranger meets this, shows those rows in Latin anyway, so a full
# Unicode width table would be code carried for a case that cannot occur.
name_of() {
  if [ "$ASCII" = yes ]; then f_latin "$1"; else f_endonym "$1"; fi
}

