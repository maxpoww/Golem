tz_top_for() {                   # $1 language code → its zones, one per line
  local want=$1 c z
  while IFS='|' read -r c z; do
    [ "$c" = "$want" ] && { printf '%s\n' "${z//,/$'\n'}"; return; }
  done <<<"$TZ_TOP"
  # A regional code falls back to its base, so a language mapped only
  # generally still opens somewhere sensible.
  [[ $want == *-* ]] && tz_top_for "${want%%-*}"
  return 0
}


TZ_ZONES=()
# The full list, ordered for the language: the zones its speakers live in
# first, then every other zone tzdata has. The top block is what makes the
# list an answer rather than a haystack — for Spanish it is Madrid, Mexico
# City, Bogotá, Buenos Aires… before the alphabet takes over.
tz_load() {
  local d all=() topz=() seen z
  d=$(tz_dir) || { TZ_ZONES=(UTC); return; }
  TZ_ROOT=$d
  mapfile -t all < <(
    find -L "$d" -type f 2>/dev/null | sed "s|^$d/||" \
      | grep -E '^[A-Z][A-Za-z_]+/' | grep -vE '^(Etc|SystemV)/' | sort -u)
  (( ${#all[@]} )) || { TZ_ZONES=(UTC); return; }

  mapfile -t topz < <(tz_top_for "${CODE[$LANG_ROW]}")
  declare -A seen=()
  TZ_ZONES=()
  for z in "${topz[@]}"; do
    [ -n "$z" ] || continue
    # A zone the medium's tzdata does not have is skipped rather than
    # offered: the list must never contain a row that cannot be chosen.
    [[ " ${all[*]} " == *" $z "* ]] || continue
    [ -n "${seen[$z]-}" ] && continue
    seen[$z]=1; TZ_ZONES+=("$z")
  done
  for z in "${all[@]}"; do
    [ -n "${seen[$z]-}" ] && continue
    TZ_ZONES+=("$z")
  done
}

# The clock in the proposed zone — the whole confirmable content of this
# step. Printed HH:MM because seconds would make the line move and motion
# is a request for attention this screen has no use for.
#
# TZDIR IS PASSED EXPLICITLY, and leaving it out was a real bug: glibc looks
# in /usr/share/zoneinfo, which NixOS does not have, so every zone quietly
# rendered the SAME time. A screen whose entire job is to show you a clock
# showing you the wrong clock — and looking completely normal doing it.
TZ_ROOT=''
tz_clock() {
  TZDIR="$TZ_ROOT" TZ="$1" date +%H:%M 2>/dev/null || printf '??:??'
}

TZ_ZONE=''

# NO PROPOSED ZONE, AND NO CONFIRM SCREEN (Max, 2026-09-05). The keyboard
# step's shape — guess, then ask "is this right?" — does not transfer here.
# A keyboard has one right answer the machine can nearly always guess; a
# language does not. Spanish is spoken across a dozen zones, so Madrid was
# right for a tenth of its speakers and the confirm screen was a ritual to
# get past for the other nine.
#
# The LIST is the step. It opens straight away, ordered so the zones of the
# countries that speak the chosen language come first — Madrid, Mexico City,
# Bogotá, Buenos Aires, Lima… — and the filter is right there for everyone
# else. A wrong guess becomes a short list instead of a wrong answer.
#
# The clock stays as the aside, so the list is scannable by the thing a
# stranger actually knows: you look for the row whose time is yours.
step_timezone() {
  tz_load
  screen; stack
  hide_cursor

  local i
  PICK_NAME=(); PICK_HAY=(); PICK_NOUN=$(t l_timezone); PICK_TITLE=$(t t_timezone)
  for i in "${!TZ_ZONES[@]}"; do
    PICK_NAME+=("${TZ_ZONES[$i]}")
    PICK_HAY+=(" ${TZ_ZONES[$i],,}")
  done
  # Re-entering after Esc opens on the zone already chosen, not back at
  # the top of the list.
  SEED=0
  for i in "${!TZ_ZONES[@]}"; do
    [ "${TZ_ZONES[$i]}" = "$TZ_ZONE" ] && { SEED=$i; break; }
  done
  QUERY=''

  # ESC leaves the step; the run loop takes it back to the language list.
  pick || return 1

  PICK_TITLE_HOT=no
  show_cursor
  TZ_ZONE=${TZ_ZONES[$PICKED]}
  settle "$(t l_timezone)" "$TZ_ZONE" "$(tz_clock "$TZ_ZONE")"
}

# ══ STEP 3 — KEYBOARD ════════════════════════════════════════════════════
#
# WHY IT IS SECOND, and it is not habit (PLAN.md). Two reasons, both load-
# bearing:
#
#   1. It overlaps the census. The probe is the one part of the install that
#      takes real time and cannot be hurried, so it runs while the user does
#      the one task that needs a human anyway. Nobody watches a spinner.
#      The line must stay true on a fast machine where the audit finishes
#      first, which is why it says the device is being read rather than
#      "wait while Golem reads" — see census_line().
#   2. It comes before the disk. With encryption on, the disk step wants a
#      passphrase, and a passphrase typed under the wrong keymap locks the
#      owner out of their own disk with NO RESCUE — worse than getting the
#      account password wrong, which at least has single-user mode. Keyboard
#      at 2 makes that impossible, and that is what lets the passphrase sit
#      on the disk screen next to the encryption toggle.
#
# WHY IT IS NOT A LIST. Step 1 already answered it: every language row
# carries a keymap and nine people in ten want the obvious pairing, so the
# default is right before anyone is asked anything. Opening with a list of
# forty layouts would make all ten do work that one of them needed.
#
# So the question is not "which layout" — it is PLAN.md's cheapest defence
# against the lockout, the live echo box: turn "do you know your locale
# code" into "does this match what is printed on your keys", which is the
# only version of the question a stranger can actually answer. The list is
# still there, one keypress down, for the tenth person.
#
#   id | name | aliases | xkb | variant | console | script | form | try
#
# THREE NAMESPACES, THREE COLUMNS. This used to be one `code` used as all of
# them, which was wrong in a way that would have shipped broken installs:
# console keymaps (kbd) and XKB layouts (xkeyboard-config) are different
# vocabularies that agree on some names and not others. Every value below is
# checked against kbd 2.9.0's keymap tree and xkeyboard-config 2.48's
# evdev.lst, not written from memory. The ones that disagree:
#
#   UK        xkb gb      console uk
#   Latin Am. xkb latam   console la-latin1
#   Brasil    xkb br      console br-abnt2
#   Japan     xkb jp      console jp106
#   Turkey    xkb tr      console trq  (and `f` → trf)
#   Hungary   xkb hu      console hu101
#   Portugal  xkb pt      console pt-latin1
#   Slovenia  xkb si      console slovene
#   Croatia   xkb hr      console croat
#   Serbia    xkb rs      console sr-cy
#
# AN EMPTY CONSOLE COLUMN IS A DELIBERATE ANSWER, NOT A HOLE. kbd ships no
# keymap at all for Arabic, Persian, Thai, Korean or the Indic scripts, so
# those rows leave it blank and console_of() falls back to `us`. That is the
# right answer twice over: the TTY has no font for those scripts anyway, and
# a rescue console you cannot type Latin on is a brick.
#
# VARIANTS ARE THEIR OWN ROWS. Colemak is not a layout, it is `us` with
# variant `colemak` — but nobody searches for "us"; they search for
# "colemak". So each variant that people actually name gets a row, and the
# xkb/variant pair behind it does the real work.
#
# PICKING THE NAME IS WHAT CONFIGURES THE MACHINE. There is no test, no
# confirmation and no "keys worth trying" column any more (Max, 2026-09-05:
# "selecting english (US), or español (latinoamérica) — is that enough?").
# It is: the row carries the xkb layout, its variant, the console keymap,
# the script and the form factor, and everything an installed machine needs
# falls out of those. See system/hardware/keyboards.nix for what the removed
# column was and when it would come back.
#
# ══ THE TABLE COMES FROM NIX ══════════════════════════════════════════════
