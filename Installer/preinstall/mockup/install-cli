UA|ua
US|us
UY|latam
VE|latam
VN|us
ZA|us
EOF
)

KB_ID=() KB_NAME=() KB_XKB=() KB_VAR=() KB_CON=() KB_SCRIPT=() KB_FORM=() KB_HAY=()
while IFS='|' read -r id n a x v c s f; do
  [ -n "$id" ] || continue
  KB_ID+=("$id"); KB_NAME+=("$n"); KB_XKB+=("$x"); KB_VAR+=("$v")
  KB_CON+=("$c"); KB_SCRIPT+=("$s"); KB_FORM+=("$f")
  h=" $n $a $id $x $v"; h=${h,,}; KB_HAY+=("${h//-/ }")
done <<<"$KEYBOARDS"
NKB=${#KB_ID[@]}

# The zone's country, from tzdata's own zone1970.tab. Several codes when a
# zone spans borders (Europe/London is "GB,GG,IM,JE"); the first is the
# principal country, which is the one whose keyboards are sold there.
tz_country() {                   # $1 zone → ISO code, or empty
  local d line
  d=$(tz_dir) || return 0
  [ -r "$d/zone1970.tab" ] || return 0
  line=$(awk -F'\t' -v z="$1" '$0 !~ /^#/ && $3 == z { print $1; exit }' "$d/zone1970.tab")
  printf '%s' "${line%%,*}"
}

kb_for_country() {               # $1 ISO code → layout id, or empty
  local want=$1 c id
  [ -n "$want" ] || return 0
  while IFS='|' read -r c id; do
    [ "$c" = "$want" ] && { printf '%s' "$id"; return; }
  done <<<"$KB_COUNTRY"
}

kb_index() {                     # id → row, us if unknown
  local i
  for (( i = 0; i < NKB; i++ )); do
    [ "${KB_ID[$i]}" = "$1" ] && { printf '%d' "$i"; return; }
  done
  printf '0'
}

# ── --verify: every value against the packages that consume them ─────────
#
# --check below proves the table is internally consistent. It cannot prove
# the NAMES are real, and a wrong name is the expensive kind of wrong: an
# unknown console keymap or XKB variant does not fail the install, it fails
# quietly at first boot and leaves a stranger with a keyboard that does not
# match their keys — the exact outcome this whole step exists to prevent.
#
# So --verify checks every id, variant, model, keymap, font and option
# against kbd's keymap tree and xkeyboard-config's evdev.lst. It is how the
# table was built and it is how it stays true; run it after any edit:
#
#   ./install-cli --verify "$(nix build --no-link --print-out-paths nixpkgs#kbd)" \
#                          "$(nix build --no-link --print-out-paths nixpkgs#xkeyboard_config)"
#
# It has already earned its place twice: it caught `in`+`deva` (deva is the
# DEFAULT group of the Indian layout, defined in symbols/in but deliberately
# absent from the advertised variant list, so the correct spelling is a bare
# `in`), and it is the only reason the gb/uk and latam/la-latin1 splits are
# known to be right rather than believed to be.
#
# This wants to be a flake check next to facts-matrix, which needs the table
# to live in nix rather than in this script — noted, not done.
kb_verify() {                    # $1 kbd out path, $2 xkeyboard-config path
  local kbd=$1 xkb=$2 lst=$2/share/X11/xkb/rules/evdev.lst bad=0 i o
  [ -r "$lst" ] || { echo "install-cli: no evdev.lst under $xkb" >&2; return 2; }

  local -A KM=() FONT=() XL=() XM=() XV=() XO=()
  while read -r n; do KM[${n%.map.gz}]=1; done \
    < <(find "$kbd/share/keymaps" -name '*.map.gz' -printf '%f\n')
  # One -printf binds only to the LAST -o branch, so match once and strip
  # after — the first draft of this silently reported every font missing.
  while read -r n; do n=${n%.gz}; FONT[${n%.psfu}]=1; FONT[${n%.psf}]=1; done \
    < <(find "$kbd/share/consolefonts" -name '*.gz' -printf '%f\n')
  while read -r n; do XL[$n]=1; done \
    < <(awk '/^! layout/,/^! variant/' "$lst" | awk 'NF>1 && $1!="!"{print $1}')
  while read -r n; do XM[$n]=1; done \
    < <(awk '/^! model/,/^! layout/' "$lst" | awk 'NF>1 && $1!="!"{print $1}')
  while read -r n; do XV[$n]=1; done \
    < <(awk '/^! variant/,/^! option/' "$lst" | awk 'NF>2 && $1!="!"{gsub(/:$/,"",$2); print $2"/"$1}')
  while read -r n; do XO[$n]=1; done \
    < <(awk '/^! option/,0' "$lst" | awk 'NF>1 && $1!="!"{print $1}')

  for (( i = 0; i < NKB; i++ )); do
    local id=${KB_ID[$i]}
    [ -n "${XL[${KB_XKB[$i]}]-}" ] || { echo "$id: xkb layout '${KB_XKB[$i]}' does not exist" >&2; bad=1; }
    [ -n "${KB_VAR[$i]}" ] && [ -z "${XV[${KB_XKB[$i]}/${KB_VAR[$i]}]-}" ] &&
      { echo "$id: '${KB_VAR[$i]}' is not a variant of '${KB_XKB[$i]}'" >&2; bad=1; }
    [ -n "${KB_CON[$i]}" ] && [ -z "${KM[${KB_CON[$i]}]-}" ] &&
      { echo "$id: console keymap '${KB_CON[$i]}' does not exist" >&2; bad=1; }

    kb_derive "$i"
    [ -n "${XM[$KB_MODEL]-}" ] || { echo "$id: xkb model '$KB_MODEL' does not exist" >&2; bad=1; }
    [ -n "${KM[$KB_CONSOLE]-}" ] || { echo "$id: derived keymap '$KB_CONSOLE' does not exist" >&2; bad=1; }
    [ -n "$KB_FONT" ] && [ -z "${FONT[$KB_FONT]-}" ] &&
      { echo "$id: console font '$KB_FONT' does not exist" >&2; bad=1; }
    for o in ${KB_OPTIONS//,/ }; do
      [ -n "${XO[$o]-}" ] || { echo "$id: xkb option '$o' does not exist" >&2; bad=1; }
    done
    # XKB reads variants positionally, so a two-group layout with one
    # variant slot silently applies the wrong variant to the wrong group.
    local -a L V
    IFS=',' read -ra L <<<"$KB_LAYOUT"
    IFS=',' read -ra V <<<"$KB_VARIANT,"
    (( ${#L[@]} > 1 && ${#V[@]} < ${#L[@]} )) &&
      { echo "$id: layout '$KB_LAYOUT' has ${#L[@]} groups, variant '$KB_VARIANT' has fewer" >&2; bad=1; }
  done

  (( bad )) && return 1
  printf '%d layouts verified against kbd + xkeyboard-config\n' "$NKB"
}

# Every language's keymap column must name a real row. The fallback in
# kb_index is a safety net for a corrupt table, NOT a place for a typo to
# live: a language quietly resolving to `us` is exactly the failure this
# whole step exists to prevent, and it would look completely normal on
# screen. --check makes it loud instead.
# Every string the code asks t() for must exist in English, because English
# is the fallback every other language falls through to. A missing one is
# not an error at runtime — t() returns empty and the screen simply draws a
# BLANK LINE where a title or a guide should be, which is how the password
# screen shipped with no title at all on 2026-09-05. It was invisible in a
# review and invisible in a run; only a diff of two screenshots would have
# caught it.
#
# The cause is worth knowing: two strings shared one line, a line-based edit
# replaced the whole line, and the second string vanished. The table is now
# one assignment per line, and this proves it stayed that way.
str_check() {
  local k bad=0 used
  used=$(grep -oE '\$\(t [a-z_]+\)|\bt [a-z_]+;' "$0" \
    | grep -oE '\bt [a-z_]+' | awk '{print $2}' | sort -u)
  for k in $used; do
    [ -n "${S[en:$k]-}" ] || { echo "install-cli: no S[en:$k] — t $k would draw a blank" >&2; bad=1; }
  done
  (( bad )) && return 1
  printf '%d strings, every one the code asks for exists\n' "$(printf '%s\n' "$used" | wc -w)"
}

kb_check() {
  local i want bad=0
  for (( i = 0; i < NROWS; i++ )); do
    want=${KEYMAP[$i]}
    [ "$want" = us ] && continue
    [ "$(kb_index "$want")" = 0 ] && {
      printf 'install-cli: language %s wants keymap "%s" — no such layout row\n' \
        "${CODE[$i]}" "$want" >&2; bad=1
    }
  done
  for (( i = 0; i < NKB; i++ )); do
    [ -n "${KB_XKB[$i]}" ] || {
      printf 'install-cli: layout %s has no xkb layout\n' "${KB_ID[$i]}" >&2; bad=1
    }
  done
  (( bad )) && return 1
  printf '%d languages, %d layouts, every pairing resolves\n' "$NROWS" "$NKB"
}

# ══ WHAT ONE ANSWER TURNS INTO ═══════════════════════════════════════════
#
# The user is asked ONE thing — is this your keyboard — and Golem derives
# every setting an installed machine needs from the row behind it. There are
# four sinks and they are not interchangeable:
#
#   console.keyMap            the TTY, and every rescue shell
#   services.xserver.xkb.*    X11 and XWayland clients
#   Hyprland input.kb_*       THE DESKTOP. Hyprland does not read the NixOS
#                             xkb option — it has its own input block, so
#                             setting only the NixOS one leaves the actual
#                             session on us. This is the sink that was
#                             missing, and it is the one that matters most.
#
# THE SECOND LAYOUT IS NOT A LUXURY. A row whose script is not Latin gets
# `us` appended as a second group plus a toggle. Without it a Russian, Greek,
# Hebrew, Arabic, Thai or Indic user has no way to type a URL, a password or
# a shell command — the machine is not merely inconvenient, it is unusable.
# Alt+Shift is the toggle because it is the one every such user already has
# muscle memory for from every other OS.
#
# Japanese and Korean are Latin-capable layouts (JIS and 2-beolsik both type
# ASCII directly; the script comes from an IME, not the layout), so they are
# marked latin and get no second group. Marking them otherwise would add a
# toggle that does nothing.
# The dim column beside a layout in the list and in its settled item. It is
# the XKB pair, because that is the identity people recognise and check —
# "us colemak" says more than "colemak" alone, and it is what the second
# layout shows up in when one gets added.
kb_aside() {
  kb_derive "$1"
  if [ -n "$KB_VARIANT" ] && [ "$KB_VARIANT" != , ]; then
    printf '%s %s' "$KB_LAYOUT" "${KB_VARIANT%,}"
  else
    printf '%s' "$KB_LAYOUT"
  fi
}

KB_LAYOUT='' KB_VARIANT='' KB_OPTIONS='' KB_CONSOLE='' KB_MODEL='' KB_FONT=''
kb_derive() {                    # $1 row → sets the six values above
  local r=$1
  KB_LAYOUT=${KB_XKB[$r]}
  KB_VARIANT=${KB_VAR[$r]}
  KB_OPTIONS=''
  # kbd has no keymap for some scripts; the TTY falls back to us on purpose.
  KB_CONSOLE=${KB_CON[$r]:-us}

  # THE PHYSICAL BOARD. XKB's model is not decoration: a JIS keyboard has
  # henkan, muhenkan and katakana keys that pc104 has no keycodes for, and
  # ABNT2 has the extra key beside the right shift. The form column already
  # knows — it was being used only to sort the list, which was leaving a
  # derivable setting on the floor.
  case ${KB_FORM[$r]} in
    jis)  KB_MODEL=jp106 ;;
    abnt) KB_MODEL=abnt2 ;;
    iso)  KB_MODEL=pc105 ;;
    *)    KB_MODEL=pc104 ;;
  esac

  # THE CONSOLE FONT. Picking a Cyrillic keymap and leaving the kernel's
  # built-in Latin font in place gives a TTY that types Russian and draws
  # boxes — the keymap is right and the screen is unreadable. Only the three
  # scripts that actually HAVE a console keymap need this; Arabic, Thai,
  # Korean and Indic fell back to `us` above, so their console is Latin and
  # the default font is correct for it.
  case ${KB_SCRIPT[$r]} in
    cyrillic|hebrew) KB_FONT=LatArCyrHeb-16 ;;
    greek)           KB_FONT=iso07u-16 ;;
    *)               KB_FONT='' ;;
  esac

  if [ "${KB_SCRIPT[$r]}" != latin ]; then
    KB_LAYOUT="$KB_LAYOUT,us"
    # XKB takes variants as a comma-separated list positionally, so the
    # second group needs its empty slot even when the first has no variant.
    KB_VARIANT="$KB_VARIANT,"
    KB_OPTIONS='grp:alt_shift_toggle'
  fi
}

# THE HANDOFF TO golem-install. These four flags are the whole contract
# between this surface and the installer: the surface asks one question and
# derives, `golem-install` writes golem.keyboard into machine.nix, and
# system/configuration.nix + system/home/home.nix fan it out to the three
# sinks. Printed by --dump settings so the derivation is inspectable
# without touching a disk.
kb_emit() {
  local r=$1
  kb_derive "$r"
  printf '%s\n' "golem-install \\"
  printf '  --kb-layout %q \\\n'  "$KB_LAYOUT"
  printf '  --kb-variant %q \\\n' "$KB_VARIANT"
  printf '  --kb-options %q \\\n' "$KB_OPTIONS"
  printf '  --kb-model %q \\\n'   "$KB_MODEL"
  printf '  --kb-console %q \\\n' "$KB_CONSOLE"
  printf '  --kb-font %q\n'       "$KB_FONT"
  printf '\n'
  printf '%s\n' "# → machine.nix"
  printf '  golem.keyboard = {\n'
  printf '    layout = "%s";\n'        "$KB_LAYOUT"
  printf '    variant = "%s";\n'       "$KB_VARIANT"
  printf '    options = "%s";\n'       "$KB_OPTIONS"
  printf '    model = "%s";\n'         "$KB_MODEL"
  printf '    consoleKeyMap = "%s";\n' "$KB_CONSOLE"
  if [ -n "$KB_FONT" ]; then
    printf '    consoleFont = "%s";\n' "$KB_FONT"
  fi
  printf '  };\n'
}

# THE SHIFT PROBE — the seam, honestly marked.
#
# The kernel hands us keycodes regardless of the loaded keymap, so pressing
# the key right of left Shift and the key left of right Shift reads the
# PHYSICAL board: KEY_Z 44 → ANSI, KEY_102ND 86 → ISO; KEY_SLASH 53 →
# ANSI/ISO, KEY_RO 89 → JIS. But that is the form FACTOR, not the language —
# France, Germany, Spain, the UK, Italy and the Nordics are all ISO, so "it
# is ISO" narrows forty layouts to thirty-nine. It sorts the list; it cannot
# decide it (PLAN.md).
#
# Reading keycodes needs evdev or `kbd_mode -k`, and bash can do neither, so
# this is the first piece of the installer that will need a helper binary.
# Everything downstream of the value is built and works: set FORM and the
# list re-sorts. When the helper lands it sets FORM and nothing else changes.
FORM=''

# ── THE ORDER THE LAYOUT LIST OPENS IN ────────────────────────────────────
#
# The same rule as the language list, and for the same reason (Max,
# 2026-09-05: "if the user select chinese, chinese should be the top one,
# second one if there is any dialect on the top language, and then the
# normal ones"):
#
#   1  the layout the chosen language implies       — the likely answer
#   2  its other variants                           — the likely correction
#   3  us · es · pt · fr · de                       — the widest few
#   …  every other layout
#
# Step 2's variants are step 1's dialects: a Spaniard's correction is
# Español — Dvorak, an American's is US-International or Colemak. Putting
# them directly under the row they correct makes the correction a keypress
# instead of a search, which is exactly what the dialect rule does for
# languages.
#
# FORM would refine this — the shift probe knows whether the board is ANSI,
# ISO or JIS — but it is not measured yet, so it is not used to sort. When
# the helper lands, this is where it comes back in.
kb_order() {                     # $1 = the row the language implies
  local seed=$1 i c
  local -A used=()
  local out=()
  _kbpush() { [ -n "${used[$1]-}" ] && return 0; used[$1]=1; out+=("$1"); }

  _kbpush "$seed"
  # Its variants: same xkb layout, different variant.
  for (( i = 0; i < NKB; i++ )); do
    [ "${KB_XKB[$i]}" = "${KB_XKB[$seed]}" ] && _kbpush "$i"
  done
  for c in us es pt fr de; do _kbpush "$(kb_index "$c")"; done
  for (( i = 0; i < NKB; i++ )); do _kbpush "$i"; done
  printf '%s\n' "${out[@]}"
}

# THE APPLY SEAM. On the medium this runs `loadkeys` before the echo box, or
# the box tests the layout the user is trying to replace and the whole step
# is theatre. In the mockup the terminal's own keymap is whatever the dev
# box has, so this is a no-op that says so.
# APPLYING IS NOT OPTIONAL, and it used to be. This sat behind --loadkeys
# and silently did nothing without it, which made the echo box theatre: the
# user pressed ñ, saw ñ, and was reading the keymap the medium booted with
# rather than the one being proposed. Now it TRIES BY DEFAULT and records
# whether it succeeded, so the screen can tell the truth either way.
#
# It also has to hold for the rest of the install, not just this screen.
# PLAN.md puts keyboard before disk because a passphrase typed under the
# wrong keymap locks the owner out with no rescue — that only works if the
# keymap the user just confirmed is the one still loaded when they type it.
KB_APPLIED=no
KB_ORIG=''
kb_apply() {
  # The CONSOLE column, not the XKB one. The echo box runs on a TTY, so it
  # must test the keymap the TTY will get — feeding it an XKB name was the
  # bug that let the box "prove" a layout the machine was never going to
  # have (`gb` is not a keymap; `uk` is).
  kb_derive "$1"
  KB_APPLIED=no
  [ "$LOADKEYS" = no ] && return 0
  command -v loadkeys >/dev/null 2>&1 || return 0
  [ "$(id -u)" = 0 ] || return 0
  # Before the FIRST load, save the keymap the machine arrived with — a
  # full dump, since the running keymap has no queryable name. Backing
  # out of the step or quitting before an install restores it (#7: test
  # runs left the bare tty "stuck in Spanish"). A completed install
  # keeps the chosen map; the machine reboots into it anyway.
  if [ -z "$KB_ORIG" ] && command -v dumpkeys >/dev/null 2>&1; then
    KB_ORIG=$(mktemp "${TMPDIR:-/tmp}/golem-kb-orig.XXXXXX")
    dumpkeys > "$KB_ORIG" 2>/dev/null || { rm -f "$KB_ORIG"; KB_ORIG=''; }
  fi
  loadkeys "$KB_CONSOLE" >/dev/null 2>&1 && KB_APPLIED=yes
  return 0
}
kb_restore() {
  [ "$KB_APPLIED" = yes ] || return 0
  [ -n "$KB_ORIG" ] && [ -r "$KB_ORIG" ] || return 0
  loadkeys "$KB_ORIG" >/dev/null 2>&1 || true
  KB_APPLIED=no
  return 0
}

# The census runs in the background from boot (audit.nix). This line reports
# it and must be TRUE IN BOTH CASES — on a fast machine the audit finishes
# before the user has typed anything, on the Acer it takes 21 s. So it
# reports state, never asks anyone to wait.
CENSUS_SECONDS=20
census_line() {
  local st
  if [ -r /var/log/golem-audit/status ]; then
    read -r st < /var/log/golem-audit/status
    case $st in ok|done) t read_ok ;; *) t reading ;; esac
  elif (( SECONDS >= CENSUS_SECONDS )); then t read_ok
  else t reading
  fi
}


# A LIST, LIKE EVERY OTHER STEP. No proposed layout, no confirmation, no
# echo box — one shape everywhere: type at the top, the likely answers under
# it, ENTER takes one.
#
# THE NAME IS THE WHOLE ANSWER. Picking "Español (Latinoamérica)" gives
# Golem the xkb layout, its variant, the model, the console keymap and the
# font — every setting an installed machine needs. There was a test here
# that asked you to press ñ ¿ ç and compare them with your keycaps; it
# configured nothing and only checked that the name was picked right, and
# people know what keyboard they own. See system/hardware/keyboards.nix.
step_keyboard() {
  local seed i cc byplace
  # THE TIMEZONE OUTRANKS THE LANGUAGE HERE, and it should: the language
  # says what you speak, the zone says where you are, and a keyboard is a
  # physical object in a place. Spanish is `es` in Madrid and `latam` in
  # Buenos Aires; English is `us` in Chicago and `gb` in London. Only the
  # zone can tell those apart, so it is asked first and the language is
  # the fallback for a country we have no entry for.
  cc=$(tz_country "$TZ_ZONE")
  byplace=$(kb_for_country "$cc")
  seed=$(kb_index "${byplace:-${KEYMAP[$LANG_ROW]}}")
  screen; stack
  hide_cursor

  mapfile -t KB_VIEW < <(kb_order "$seed")
  PICK_NAME=(); PICK_HAY=(); PICK_NOUN=$(t l_keyboard); PICK_TITLE=$(t t_keyboard)
  for i in "${KB_VIEW[@]}"; do
    PICK_NAME+=("${KB_NAME[$i]}")
    PICK_HAY+=("${KB_HAY[$i]}")
  done
  # Re-entering after Esc opens on the layout already chosen; first time
  # through, on the one the language and timezone imply.
  SEED=0
  if [ -n "$KB_CHOSEN" ]; then
    for i in "${!KB_VIEW[@]}"; do
      [ "${KB_ID[${KB_VIEW[$i]}]}" = "$KB_CHOSEN" ] && { SEED=$i; break; }
    done
  fi
  QUERY=''

  # ESC leaves the step; the run loop takes it back to the timezone — and
  # takes back the keymap a previous pass through this step applied (#7).
  pick || { kb_restore; return 1; }

  PICK_TITLE_HOT=no
  show_cursor
  KB_ROW=${KB_VIEW[$PICKED]}
  KB_CHOSEN=${KB_ID[$KB_ROW]}
  kb_apply "$KB_ROW"
  settle "$(t l_keyboard)" "${KB_NAME[$KB_ROW]}" "$(kb_aside "$KB_ROW")"
}

# ══ STEP 4 — DISK ════════════════════════════════════════════════════════
#
# THE SAME WORKFLOW AGAIN — propose, show the evidence, ENTER or ↓ — but
# this is the first step whose answer DESTROYS something, and that changes
# two things about it.
#
# WHAT THE EVIDENCE IS. For the keyboard it was what your keys produce; for
# the timezone, a clock. Here it is WHAT IS ON THE DISK RIGHT NOW — the
# partitions and their labels. A stranger does not recognise a disk by
# "/dev/sda"; they recognise it by "oh, that's the one with Windows on it".
# Showing the contents is the only version of "is this the right disk" they
# can actually answer, and it is also the only way they will notice that
# the highlighted disk is the one they meant to keep.
#
# THE WARNING LIVES HERE AND NOWHERE ELSE (PLAN.md): "Install does NOT warn
# about erasing. The disk step owns that warning." Saying it twice makes the
# real one cheap; saying it early frightens somebody who has not chosen a
# disk yet. So the footer of this screen carries it, in the accent rather
# than the dim ramp, because it is the one line on any screen so far that
# describes something irreversible.
#
# NOTHING IS ERASED BY THIS STEP. It records a target. The erase happens at
# step 6, where the summary is confirmed — one screen for confirm, progress
# and done, so the progress IS the confirmation being answered line by line.
#
# THE MEDIUM IS NOT IN THE LIST. The stick you booted from is a disk like
# any other to lsblk, and offering it is offering to eat the installer
# mid-install. Anything holding the live root is filtered out.
DISK_DEV=() DISK_MODEL=() DISK_SIZE=() DISK_NOW=() DISK_RM=()

# --fake-disks: a canned set, so this screen can be looked at on a machine
# whose only disk is the one it booted from. On the dev box the real load
# below correctly finds NOTHING — which is the filter working, and also
# means the screen is otherwise unreviewable until a lab machine is in hand.
disk_fake() {
  DISK_DEV=(/dev/sda /dev/sdb /dev/nvme0n1)
  DISK_MODEL=("WDC WD10JPVX-22JC3T0" "SanDisk Ultra" "Samsung SSD 970 EVO")
  DISK_SIZE=("932G" "29G" "477G")
  DISK_NOW=("3 partitions · Windows · Data" "1 partition, unlabelled" "empty")
  DISK_RM=(0 1 0)
}

disk_load() {
  DISK_DEV=(); DISK_MODEL=(); DISK_SIZE=(); DISK_NOW=(); DISK_RM=()
  [ "$FAKE_DISKS" = yes ] && { disk_fake; return 0; }
  command -v lsblk >/dev/null 2>&1 || return 0

  # What the live system is running from — never a target. On the medium
  # the live root is a TMPFS, so chasing / finds no disk and filters
  # nothing — the Dell's round-2 drive list offered the very stick it
  # booted from (#20). The stick is the disk behind /iso, same source the
  # engine's own target≠medium check reads; / stays as the dev-box
  # fallback, where the root really is a disk.
  local boot='' src
  src=$(findmnt -no SOURCE /iso 2>/dev/null) || src=$(findmnt -no SOURCE / 2>/dev/null || true)
  if [ -n "$src" ]; then
    # A USB isohybrid mounts /iso from the WHOLE DISK (/dev/sdb), not a
    # partition — so its PKNAME row is EMPTY and `head -1` grabbed the
    # blank line, leaving boot='' and offering the stick anyway (#20b,
    # ASUS round 3). Take the first NON-empty PKNAME; if there is none,
    # the source already IS the whole disk, so strip /dev/ off it — the
    # exact recipe the engine's target≠medium check uses.
    boot=$(lsblk -no PKNAME "$src" 2>/dev/null | grep -m1 . || true)
    [ -n "$boot" ] || boot=${src##*/}
  fi

  # --pairs, NOT plain columns. lsblk's list output simply OMITS an empty
  # column, and virtio disks have no MODEL and no TRAN — so `read` shifted
  # every later field left, TYPE landed in the wrong variable, and every
  # disk in every VM was silently filtered out. The surface said "No disk
  # found to install on" to a machine with a 40 GB disk attached; only
  # booting the real medium caught it. KEY="VALUE" pairs cannot collapse.
  # (Third find of this exact bug class in two days: keyboard-check's tab
  # columns, the t()-string lines, now this. Delimited-column parsing in
  # bash is guilty until proven framed.)
  local pairs name size model tran rm type
  while IFS= read -r pairs; do
    name=''; size=''; model=''; tran=''; rm=''; type=''
    eval "$(printf '%s' "$pairs" | sed -E 's/([A-Z]+)=/\L\1=/g')"
    [ "$type" = disk ] || continue
    [ "$name" = "$boot" ] && continue
    # loop/zram/ram are not disks anyone installs to
    case $name in loop*|zram*|ram*|sr*) continue ;; esac

    DISK_DEV+=("/dev/$name")
    # No model string on some USB bridges and most VM disks — the device
    # name is the honest fallback, and it is what lsblk itself shows.
    DISK_MODEL+=("${model:-$name}"); DISK_SIZE+=("$size")
    DISK_RM+=("$rm")

    # What is on it now, as a human would name it: the filesystems that
    # carry a label, else just how many partitions there are.
    local parts labels
    parts=$(lsblk -no NAME "/dev/$name" 2>/dev/null | tail -n +2 | wc -l)
    labels=$(lsblk -no LABEL "/dev/$name" 2>/dev/null | grep -v '^$' | paste -sd' · ' - || true)
    if [ -n "$labels" ]; then
      DISK_NOW+=("$parts partitions · $labels")
    elif [ "$parts" -gt 0 ]; then
      DISK_NOW+=("$parts partitions, unlabelled")
    else
      DISK_NOW+=("empty")
    fi
  done < <(lsblk -dP -o NAME,SIZE,MODEL,TRAN,RM,TYPE 2>/dev/null)
}



# Internal disks before removable ones. A USB stick is almost never the
# thing somebody means to install onto, and the one they booted from is
# already filtered out — but a second stick in the other port is not, and
# it should not be sitting at the top of a list whose warning says
# everything on it will be erased.
DISK_VIEW=()
disk_order() {
  local i
  DISK_VIEW=()
  for i in "${!DISK_DEV[@]}"; do [ "${DISK_RM[$i]}" = 0 ] && DISK_VIEW+=("$i"); done
  for i in "${!DISK_DEV[@]}"; do [ "${DISK_RM[$i]}" != 0 ] && DISK_VIEW+=("$i"); done
}

# ONE SHAPE, AND THIS STEP OBEYS IT TOO. It proposed and asked for a
# confirmation like the old keyboard and timezone steps did; it is a list
# now, ordered by importance — internal disks before removable ones,
# largest first — because that is the order of how likely a disk is to be
# the one somebody means to install on.
#
# THE WARNING SITS ABOVE THE LIST, not inside it. It is about the STEP, not
# about any one row, and putting it in the picker would have meant a
# different picker for one screen. It is the only line in the installer
# printed in the accent, because it is the only one describing something
# that cannot be undone.
step_disk() {
  disk_load
  screen; stack
  if (( ${#DISK_DEV[@]} == 0 )); then
    # A machine with no usable target fails HERE, before anyone has typed a
    # name or a password — which is the whole reason disk comes before you.
    printf '%s%s%s%s\n\n' "$IND" "$C_ACCENT" "$(t disk_none)" "$NORM"
    DISK_TARGET=''
    return 1
  fi
  disk_order
  local i n

  # THE LAST ROW IS A DOOR, not a disk. Everything unusual about installing
  # — encryption, one partition, dual boot — lives behind it, so the
  # ordinary path stays exactly one keypress and nothing else has to be
  # read to reach it.
  while :; do
    screen; stack
    hide_cursor
    PICK_NAME=(); PICK_HAY=(); PICK_NOUN=$(t l_disk)
    PICK_TITLE="$(t t_disk) — $(t disk_warn)"; PICK_TITLE_HOT=yes
    # NO /dev PATH IN THE LIST. It is a fact about the kernel, not about the
    # disk somebody is looking at — nobody recognises their drive as sda.
    # The model and the size are what is printed on the object itself, and
    # they are what the answer file and golem-install's own plan still carry
    # the path for. Two columns, so the sizes line up and the eye can
    # compare them: model left, size right-aligned under each other.
    local mw=0 sw=0 w
    for i in "${DISK_VIEW[@]}"; do
      w=$(dwidth "${DISK_MODEL[$i]}"); (( w > mw )) && mw=$w
      w=$(dwidth "${DISK_SIZE[$i]}");  (( w > sw )) && sw=$w
    done
    for i in "${DISK_VIEW[@]}"; do
      PICK_NAME+=("$(pad_to "${DISK_MODEL[$i]}" "$mw")   $(printf '%*s' "$sw" "${DISK_SIZE[$i]}")")
      # The path stays searchable even though it is not shown: somebody who
      # knows they want sdb can still type it.
      PICK_HAY+=(" ${DISK_DEV[$i],,} ${DISK_MODEL[$i],,} ${DISK_SIZE[$i],,} ${DISK_NOW[$i],,}")
    done
    n=${#DISK_VIEW[@]}
    PICK_NAME+=("$(t adv_row)")
    PICK_HAY+=(" advanced avanzado avance erweitert avanzate luks encrypt cifrar dual partition")
    # Re-entering after Esc opens on the disk already chosen.
    SEED=0
    for i in "${!DISK_VIEW[@]}"; do
      [ "${DISK_DEV[${DISK_VIEW[$i]}]}" = "$DISK_TARGET" ] && { SEED=$i; break; }
    done
    QUERY=''

    # ESC leaves the step; the run loop takes it back to the keyboard.
    pick || return 1
    PICK_TITLE_HOT=no
    if (( PICKED == n )); then step_advanced; continue; fi
    DISK_ROW=${DISK_VIEW[$PICKED]}
    break
  done

  show_cursor
  DISK_TARGET=${DISK_DEV[$DISK_ROW]}
  # Capitalise the red tail's first letter here — "(Will be erased)" — the
  # same descriptive-value rule as the census.
  # The red tail says the consequence: just "erased" normally, "erased and
  # encrypted" when LUKS is on (Max, round 2) — so the summary a person
  # confirms names the encryption on the very line about their disk.
  local e; e=$(t erased); [ "$LUKS" = yes ] && e=$(t erased_enc)
  settle "$(t l_disk)" "${DISK_MODEL[$DISK_ROW]}  ${DISK_SIZE[$DISK_ROW]}" "" "" "(${e^})"
  # Only worth a row of its own once it is on: "encryption off" on every
  # install would be a line about a non-event. LOCKED in the danger colour
  # (arg 4 = value colour), matching the Advanced row.
  [ "$LUKS" = yes ] && settle "$(t l_luks)" "$(t luks_on)" "" "$C_RED"
  return 0
}

# ══ STEP 5 — ENCRYPTION ══════════════════════════════════════════════════
#
# Straight after the disk, because it is a question ABOUT that disk and
# because saying yes changes how the disk gets partitioned — the answer has
# to be in hand before anything is written.
#
# WHY THE KEYBOARD IS THREE STEPS EARLIER, and this is the payoff PLAN.md
# ordered the whole installer around: a passphrase typed under the wrong
# keymap locks the owner out of their own disk with NO RESCUE. Not a wrong
# password on an account, which single-user mode can fix — a container that
# cannot be opened by anyone, ever. The layout is settled and loaded by the
# time this screen appears, which is the only reason it is safe to ask.
#
# THE PASSPHRASE IS SHOWN IN THE CLEAR for the same reason the account
# password is, only more so: this is the one secret in the install with no
# recovery path, so being able to READ what you typed matters more here
# than hiding it from a room you are alone in.
#
# THE DEFAULT IS NO, and that is now a DECISION rather than a placeholder
# (Max, 2026-09-05). The default install is: no encryption, ext4, a swap
# partition sized for hibernation, whole disk erased. Encryption is
# something a person goes looking for behind Advanced, not something every
# stranger is asked about — and this list opens on "No" to match.
LUKS=no
LUKS_KEYFILE=''

valid_lpass() {
  [ ${#FIELD_VALUE} -ge 8 ] && return 0
  FIELD_ERR=$(t e_lpass); return 1
}

# ── the advanced menu, reached from the last row of the disk list ────────
#
# WHY IT IS BEHIND A DOOR (Max, 2026-09-05: "so the user can just select the
# drive, but if he wants something else he can go to advanced"). Encryption,
# installing onto one partition, and dual-booting are all real needs and all
# rare. Putting them in the main flow would make every stranger read three
# questions to answer none of them; putting them one row below the disks
# costs the people who want them a single keypress and costs everyone else
# nothing.
#
# IT IS A DETOUR, NOT A STEP. Turning encryption on here does not choose a
# disk, so it comes straight back to the disk list — the thing this step
# exists to settle is still unsettled until a disk is taken.
#
# UNFINISHED ENTRIES SAY SO. census-mock's rule, and it holds: "a button
# that quietly does nothing costs more trust than one that says so." The
# two that are not built are listed, selectable, and answer honestly.
ADV_MSG=''
step_advanced() {
  local seed_row=0
  while :; do
    screen; stack
    hide_cursor
    local luks_row="$(t adv_luks)"
    # LOCKED in the danger colour, not the same ink as everything else
    # (Max, round 2): encryption is the one irreversible-if-you-lose-the-key
    # choice, so its state stands out on the row that carries it.
    [ "$LUKS" = yes ] && luks_row="$luks_row — ${C_RED}$(t luks_on)${NORM}"
    # Order per Max, 2026-09-05. Not by how finished they are — dual boot
    # and partition installs are the two that are not built — but by how
    # a person thinks about the disk: what else is on it, then which part
    # of it, then what to do to it.
    PICK_NAME=("$(t adv_dual)" "$(t adv_part)" "$luks_row" "$(t adv_back)")
    # "Dual-Boot" is BORROWED, not translated, in every language here —
    # Spanish, Portuguese and French speakers say dual-boot, and nobody
    # says "arranque dual" outside a dictionary. The literal translations
    # stay as SEARCH terms so somebody who reaches for one still lands on
    # the row; they are just not what the row is called.
    PICK_HAY=(" $(t adv_dual) dual boot arranque dual amorcage double amorçage arranque duplo doppio avvio"
              " $(t adv_part) partition particion partizione partição"
              " $(t adv_luks) luks encrypt encryption cifrar cifrado chiffrer verschl"
              " $(t adv_back) back volver retour zuruck indietro voltar")
    PICK_NOUN=$(t t_adv)
    PICK_TITLE=$(t t_adv)
    [ -n "$ADV_MSG" ] && PICK_TITLE="$PICK_TITLE — $ADV_MSG"
    ADV_MSG=''
    SEED=$seed_row; QUERY=''
    seed_row=0
    pick || return 0             # backing out is the same as Back
    case $PICKED in
      0|1) ADV_MSG=$(t adv_soon) ;;   # dual boot, partition — not built
      # After turning encryption on, reopen with Back highlighted (Max,
      # round 2): the person sees "— LOCKED" and one ENTER returns them to
      # the drive list, rather than landing back on Dual-Boot.
      2)   step_luks; [ "$LUKS" = yes ] && seed_row=3 ;;
      3)   return 0 ;;
    esac
  done
}

step_luks() {
  screen; stack
  hide_cursor

  PICK_NAME=("$(t luks_yes)" "$(t luks_no)")
  PICK_HAY=(" yes si sí oui ja sim encrypt cifrar chiffrer verschl cifra"
            " no non nein não")
  PICK_NOUN=$(t l_luks); PICK_TITLE=$(t t_luks)
  SEED=1                         # No — see the note above
  QUERY=''
  pick || return 1
  [ "$PICKED" = 0 ] && LUKS=yes || LUKS=no

  if [ "$LUKS" = yes ]; then
    # TYPED TWICE (Max, round 2), even though it is shown in the clear: this
    # is the one secret with no recovery, so a second entry is deliberate
    # friction, not redundancy — the same gate the account password has.
    # Mismatch sends you back to the first field.
    local lp1
    while :; do
      screen; stack
      if ! ask_field "$(t t_lpass)" "$(t p_lpass)" "" valid_lpass; then
        LUKS=no; return 1                # ESC on the passphrase = no encryption
      fi
      lp1=$FIELD_VALUE
      screen; stack
      if ask_field "$(t t_lcpass)" "$(t p_lpass)" "" valid_lpass; then
        [ "$FIELD_VALUE" = "$lp1" ] && break
        FIELD_ERR_INIT=$(t e_lcpass)
      fi
    done

    # THE PASSPHRASE CANNOT BE HASHED — cryptsetup needs the real thing to
    # format the container — so it cannot ride in the answers file either.
    # It goes to a 0600 file in TMPDIR, which on the medium is a tmpfs and
    # therefore RAM: it is never written to any disk, and golem-install
    # shreds it the moment the container exists.
    LUKS_KEYFILE=$(mktemp "${TMPDIR:-/tmp}/golem-luks.XXXXXX")
    chmod 600 "$LUKS_KEYFILE"
    printf '%s' "$lp1" > "$LUKS_KEYFILE"
    lp1=''; FIELD_VALUE=''

    # The scare, on its own screen: a full-drive-encryption stranger who
    # does not grasp "no recovery" can lose everything, so make them
    # acknowledge it. ESC here backs all the way out — encryption off.
    screen; stack
    hide_cursor
    printf '\n%s%s%s%s\n' "$IND" "$C_RED" "$(t luks_warn)" "$NORM"
    printf '\n%s%s%s%s\n' "$IND" "$C_DIM" "$(t luks_ack)" "$NORM"
    while :; do
      read_key || continue
      case $KEY in
        ENTER) break ;;
        ESC)   LUKS=no; rm -f "$LUKS_KEYFILE"; LUKS_KEYFILE=''; return 1 ;;
        *)     ;;
      esac
    done
  fi

  show_cursor
  # No stack row from here. This is a detour off the disk step, and the
  # stack records SETTLED STEPS — the disk step adds the encryption line
  # itself once a disk has actually been taken. Settling here put
  # "encryption on" above a disk that had not been chosen yet.
}

# ══ STEP 6 — YOU ═════════════════════════════════════════════════════════
#
# The first step that is not a list, because there is nothing to choose
# from — you are the only source of these three answers. It keeps the shape
# anyway: a title saying what is being asked, one line to type on, the guide
# under it, and a footer.
#
# THE FOOTER IS NOT DECORATION HERE. Every other step's footer reported the
# census; on this one it says where the answer goes, and it says something
# DIFFERENT per field because the truth is different per field. Two of the
# three never leave the machine; the hostname is broadcast to every network
# it joins. Saying "we care about your privacy" three times would be
# theatre. Saying which of the three is visible is useful.
#
# THE PASSWORD IS SHOWN IN THE CLEAR, and PLAN.md ranked that as the
# CHEAPEST defence against the keymap lockout, ahead of the echo box that no
# longer exists: masking defeats shoulder-surfing, which is not the threat
# when one person is alone at their own machine during a one-time setup, and
# it hides the exact typo that locks them out of their own disk. Being able
# to read it is also why it is not asked for twice.
FIELD_VALUE=''
FIELD_SECRET=no
FIELD_ERR=''
# A ghost suggestion: shown dimmed while the field is empty, and taken on
# ENTER if nothing was typed. Distinct from the INITIAL value (ask_field
# arg 3), which is real text the user edits. The hostname step used to
# pass its "Golem" default AS the initial value, so a printable keystroke
# appended to it — typing "acer-lab" produced "Golemacer-lab" on the Acer
# (2026-09-06). A placeholder is not a value.
FIELD_SUGGEST=''
FBLOCK=7                         # title · blank · input · blank · guide · blank · footer

paint_field() {
  printf '\r%s[2K%s%s%s%s\n' "$esc" "$IND" "$C_ASK" "$FIELD_TITLE" "$NORM"
  printf '\r%s[2K\n' "$esc"
  # Masked when the field is a secret. What that costs is the ability to
  # READ a typo, which is why the password is asked twice — the defence
  # against a mistyped password moved from "you can see it" to "you typed
  # it twice", and one of the two has to be there.
  local shown=$FIELD_VALUE vcolor=$C_VALUE
  if [ "$FIELD_SECRET" = yes ]; then
    shown=$(printf '%*s' "${#FIELD_VALUE}" '' | tr ' ' '*')
  elif [ -z "$FIELD_VALUE" ] && [ -n "$FIELD_SUGGEST" ]; then
    # Nothing typed yet: the suggestion stands in, dimmed so it reads as a
    # placeholder rather than text already entered. The first keystroke
    # fills the (empty) FIELD_VALUE and this branch stops firing.
    shown=$FIELD_SUGGEST; vcolor=$C_DIM
  fi
  printf '\r%s[2K%s%s%s%s %s%s%s%s\n' "$esc" "$IND" "$C_ACCENT" "$CARET" "$NORM" \
    "$vcolor" "$shown" "$NORM" \
    "$( [ "$TTY" = yes ] && printf '%s[7m %s[0m' "$esc" "$esc" )"
  printf '\r%s[2K\n' "$esc"
  # The error replaces the guide rather than joining it: a line that says
  # what to press is useless while the thing you typed cannot be accepted.
  if [ -n "$FIELD_ERR" ]; then
    printf '\r%s[2K%s%s%s%s\n' "$esc" "$IND" "$C_RED" "$FIELD_ERR" "$NORM"
  else
    printf '\r%s[2K%s%s%s  ·  %s%s\n' "$esc" "$IND" "$C_DIM" \
      "$(t f_keys)" "$(t key_back)" "$NORM"
  fi
  printf '\r%s[2K\n' "$esc"
  printf '\r%s[2K%s%s%s%s\n' "$esc" "$IND" "$C_DIM" "$FIELD_FOOT" "$NORM"
  printf '%s[%dA' "$esc" "$FBLOCK"
}

FIELD_TITLE='' FIELD_FOOT=''
# FIELD_ERR_INIT lets a caller open a field already showing a red error —
# the password mismatch does this, so the field re-opens with "the passwords
# didn't match" in red rather than the same message greyed into the footer.
# It clears on the first keypress, as any field error does.
FIELD_ERR_INIT=''
ask_field() {                    # $1 title  $2 footer  $3 initial  $4 validator  $5 suggest
  FIELD_TITLE=$1; FIELD_FOOT=$2; FIELD_VALUE=$3; FIELD_SUGGEST=${5:-}
  FIELD_ERR=$FIELD_ERR_INIT; FIELD_ERR_INIT=''
  local i rc=0
  while :; do
    paint_field
    read_key || continue
    case $KEY in
      # ENTER on an untouched field takes the ghost suggestion: what the
      # user saw dimmed IS the value they are accepting, so it validates as
      # that rather than as empty. Typing replaced the ghost, so this only
      # fires when they meant the default.
      ENTER)  [ -z "$FIELD_VALUE" ] && [ -n "$FIELD_SUGGEST" ] && FIELD_VALUE=$FIELD_SUGGEST
              "$4" && break; ;;
      BACK)   FIELD_VALUE=${FIELD_VALUE%?}; FIELD_ERR='' ;;
      # ESC leaves the field rather than clearing it — BACKSPACE already
      # clears, and one key cannot mean both without the smaller mistake
      # (a typo) and the larger one (wrong step) sharing a keystroke.
      ESC)    rc=1; break ;;
      UP|DOWN|SIDE|OTHER) ;;
      *)      FIELD_VALUE="$FIELD_VALUE$KEY"; FIELD_ERR='' ;;
    esac
  done
  for (( i = 0; i < FBLOCK; i++ )); do printf '%s[2K\n' "$esc"; done
  printf '%s[%dA' "$esc" "$FBLOCK"
  return $rc
}

# Linux account names: lowercase, start with a letter, 32 max. Enforced
# here rather than at install time because a rejection three screens later
# is a rejection nobody can act on.
valid_name() {
  [[ $FIELD_VALUE =~ ^[a-z][a-z0-9_-]{0,31}$ ]] && return 0
  FIELD_ERR=$(t e_name); return 1
}
valid_pass() {
  [ -n "$FIELD_VALUE" ] && return 0
  FIELD_ERR=$(t e_pass); return 1
}
# RFC 1123: letters, digits and dashes, no dash at either end.
valid_host() {
  [[ $FIELD_VALUE =~ ^[a-zA-Z0-9]([a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?$ ]] && return 0
  FIELD_ERR=$(t e_host); return 1
}

OWNER='' HOSTNAME_V='' PASS_HASH=''

# THE PLAINTEXT NEVER LEAVES THIS FUNCTION. mkpasswd reads it on stdin
# rather than argv, because an argument is visible in `ps` to every user on
# the machine for as long as the process lives — a detail nobody would ever
# notice was wrong, on the one screen where being wrong about it matters.
hash_password() {
  local pw=$1
  if command -v mkpasswd >/dev/null 2>&1; then
    PASS_HASH=$(printf '%s' "$pw" | mkpasswd -m yescrypt -s 2>/dev/null) || PASS_HASH=''
  fi
  # No mkpasswd (the mockup on a bare box): record that a password was set
  # without recording the password. golem-install hashes it on the medium,
  # where mkpasswd is a runtime input.
  [ -n "$PASS_HASH" ] || PASS_HASH='!unhashed'
}

# Device, then user, then the password twice (Max, 2026-09-05). The machine
# is named before the person because the two are easy to confuse when they
# arrive the other way round — "your name" followed by "name this device"
# reads as one question asked twice.
# FOUR FIELDS, AND ESC WALKS BACK THROUGH THEM ONE AT A TIME before it
# leaves the step. Going straight out to the disk list because somebody
# mistyped the last character of a password would be a worse answer than
# no back button at all.
#
# Each field re-opens carrying what was typed before, so "I misspelled my
# name" is Esc, fix the letter, ENTER — not Esc and type it all again. The
# passwords are the exception: they come back empty, because a masked field
# pre-filled with asterisks cannot be read or trusted.
step_you() {
  local f=0 ptitle foot pass1=''
  foot=$(t p_pass)
  while :; do
    case $f in
      0) screen; stack
         # "Golem" is the GHOST (arg 5), not the initial value (arg 3):
         # first time in, HOSTNAME_V is empty so "Golem" shows dimmed and
         # ENTER takes it; on re-open after ESC, HOSTNAME_V holds what the
         # user typed and is edited normally, no ghost. This is what stops
         # a typed name appending to the default ("Golemacer-lab").
         if ask_field "$(t t_host)" "$(t p_host)" "$HOSTNAME_V" valid_host Golem
           then HOSTNAME_V=$FIELD_VALUE; f=1
           else return 1                      # out of the step, to the disk
         fi ;;
      1) screen; stack
         if ask_field "$(t t_name)" "$(t p_name)" "$OWNER" valid_name
           then OWNER=$FIELD_VALUE; f=2
           else f=0
         fi ;;
      # THE PASSWORD SCREEN IS ADDRESSED TO A PERSON, not to a field: once
      # the account has a name the question is "ana's password", which is
      # also the only cue that the thing being set belongs to the account
      # just created rather than to the disk or the installer.
      2) screen; stack
         ptitle=$(t t_pass); ptitle=${ptitle/'%s'/$OWNER}
         FIELD_SECRET=yes
         if ask_field "$ptitle" "$foot" "" valid_pass
           then pass1=$FIELD_VALUE; f=3
           else FIELD_SECRET=no; f=1
         fi ;;
      3) screen; stack
         FIELD_SECRET=yes
         if ask_field "$(t t_cpass)" "$(t p_pass)" "" valid_pass; then
           if [ "$FIELD_VALUE" = "$pass1" ]; then FIELD_SECRET=no; break; fi
           # A mismatch sends you back to the FIRST field, not just this
           # one. Retyping only the confirmation cannot help if it was the
           # first that was mistyped, and there is no way to tell which.
           # The message goes on the password screen because that is where
           # it explains something; by the time you reach here again it is
           # no longer news.
           FIELD_ERR_INIT=$(t e_cpass); f=2
         else f=2
         fi ;;
    esac
  done
  FIELD_SECRET=no

  hash_password "$pass1"
  pass1=''; FIELD_VALUE=''       # neither copy outlives this function

  show_cursor
  settle "$(t l_host)" "$HOSTNAME_V"
  settle "$(t l_name)" "$OWNER"
}

# ══ STEP 7 — CONFIRM · PROGRESS · DONE, ONE SCREEN ═══════════════════════
#
# PLAN.md wrote this screen's law before there was a screen: "the summary
# stays put and fills in as each part lands, so the progress IS the
# confirmation being answered line by line." The stack has been the summary
# all along — six items the person answered. Pressing ENTER after the
# password REVEALS THE REST OF IT: everything Golem decided on its own
# (Max, 2026-09-06: "all the things we are gonna install reveal as more
# items"). The census rows land in the same dot-item shape as the answers,
# because they are the same kind of thing — decisions, just not yours.
#
# The reveal reads /var/log/golem-audit/decision.json — the ordered list
# decide.nix returns, written by the boot-time audit that has been running
# since before the first question. The renderer stays deliberately dumb:
# label = k, value = v, in the file's order. --fake-census supplies canned
# rows so this screen exists on a dev box too.
#
# THEN ONE QUESTION, then the bar. The bar is fed by ##golem N/M markers
# golem-install prints at real phase boundaries — measured progress, not
# animation. 6/6 is printed only after nixos-install succeeds, and it is
# the ONLY thing that triggers the reboot: a bar that ends because the
# script ended would restart a machine that has no system on it.
FAKE_CENSUS=no
FAKE_INSTALL=no

# The reveal has TWO halves that answer the two questions a burned Linux
# user actually asks. The config half — "what did Golem set up" — comes from
# decide.nix (or canned, faked). The hardware half — "did it even SEE my
# wi-fi" — is read live off the machine, because that is the one a summary
# from a file cannot fake convincingly. A GPU name pulled from lspci on the
# same silicon the session is running is proof, not a promise.
# #28: hold the reveal until the boot audit has finished. audit.nix
# creates status EMPTY at the start and writes "ok"/"FAILED …" only when
# it ends — so a non-empty status is terminal, an empty one is still
# running. A fast user on a slow machine (MacBook: 60 s audit) reached
# this screen mid-audit: the rows read "audit incomplete", then the
# audit's own tty1 banner landed on top (the owns-console marker now
# stops that half). Bounded; if there is no status file at all there is
# no audit to wait for (dev box / demo).
wait_for_audit() {
  local i
  [ -e /var/log/golem-audit/status ] || return 0
  [ -s /var/log/golem-audit/status ] && return 0
  printf '\n%s%s%s%s' "$IND" "$C_DIM" "$(t reading)" "$NORM"
  for i in $(seq 1 45); do
    [ -s /var/log/golem-audit/status ] && break
    sleep 1
  done
}

census_reveal() {
  local k v
  [ "$FAKE_CENSUS" = yes ] || wait_for_audit
  if [ "$FAKE_CENSUS" = yes ]; then
    # Curated to the decisions worth showing next to the hardware — the
    # ones the hardware block does not already imply (no `driver`, no
    # `bluetooth on`: the GPU and Bluetooth rows below say those).
    while IFS='|' read -r k v; do answered "$k" "${v^}"; done <<'EOF'
zram|150% of RAM, zstd
swap|6 GiB, for hibernation
thermald|on
lid|suspend-then-hibernate
scheduler|bfq on rotating disks
EOF
  elif [ -s /var/log/golem-audit/decision.json ] && command -v jq >/dev/null 2>&1; then
    # ${val^} capitalises the first letter of the DECISION values — these
    # are descriptive, not identifiers, so lifting the first letter is
    # safe. A value that leads with a number ("6 GiB…") is unchanged.
    #
    # The audit writes v in English at boot, before any language exists —
    # so each surfaced row also carries a stable `key` + `args`, and the
    # sentence is rendered HERE, in the chosen language (#18e). An empty
    # or unknown key falls back to v, so an older audit file still shows
    # something true.
    # Field separator \x1f, record separator \x1e for args — NOT @tsv:
    # tab is IFS *whitespace*, so an empty middle field (the lid row's
    # key) collapsed and shifted every later field left (VM gate,
    # round-3 close — "Tapa" rendered valueless).
    local k key args v lbl val a1 a2
    while IFS=$'\x1f' read -r k key args v; do
      lbl=$k; val=$v
      IFS=$'\x1e' read -r a1 a2 _ <<<"$args"
      case $key in
        zram)           val=$(t dv_zram | sed -e "s/%1/$a1/" -e "s/%2/$a2/") ;;
        swap_hib)       val=$(t dv_swap | sed -e "s/%1/$a1/") ;;
        on)             val=$(t dv_on) ;;
        off)            val=$(t dv_off) ;;
        lid_sth)        val=$(t dv_lid_sth) ;;
        bfq)            val=$(t dv_bfq) ;;
        kernel_default) val=$(t dv_kdef) ;;
      esac
      case $k in
        lid)       lbl=$(t dl_lid) ;;
        scheduler) lbl=$(t dl_sched) ;;
        scale)     lbl=$(t dl_scale)
                   # R3-5: the scale is the most visible thing about a
                   # high-DPI machine after first boot, and the reveal
                   # never mentioned it. Show it — but only when it is
                   # NOT 1.0 (decide.nix writes "none (normal density)"
                   # there), so ordinary-density machines stay quiet.
                   case $val in none*) continue ;; esac ;;
      esac
      answered "$lbl" "${val^}"
    done < <(
      jq -r '.[] | .rows[] | select(.k=="zram" or .k=="swap" or .k=="thermald"
             or .k=="lid" or .k=="scheduler" or .k=="scale")
             | [.k, (.key // ""), ((.args // []) | join("\u001e")), .v] | join("\u001f")' \
             /var/log/golem-audit/decision.json 2>/dev/null)
  elif [ -r /var/log/golem-audit/status ]; then
    # The audit RAN (only the medium writes a status) but its decision
    # half is unreadable — decide crashed, or jq is missing. Silence here
    # read as "nothing to decide" on the ASUS (#22); one honest dim line
    # instead. The install itself is unaffected (the target eval never
    # reads the decision surface — proven the same day it broke).
    printf '%s%s%s%s\n' "$IND" "$C_DIM" "$(t audit_bad)" "$NORM"
  fi
  # A blank between "what Golem set up" and "what it found" — the two halves
  # answer different questions and the gap says so.
  printf '\n'
  hardware_reveal
  return 0
}

# ── the hardware, named, with the driver that runs it ─────────────────────
#
# Real off the machine: lspci -k names the GPU / Wi-Fi / audio controllers
# and the kernel module bound to each; lsusb finds the Bluetooth radio and
# the fingerprint reader; /proc/bus/input/devices finds the touchpad and a
# touchscreen if there is one. Each row is "<what it is> · <what runs it>",
# and a device that is not there gets no row — that is the "if available"
# rule, and it is why the list is exactly as long as the hardware is real.
#
# Under --fake-disks the whole block is a canned laptop, so the LAYOUT can
# be seen on a dev box that has no touchpad — but the driver COUNT below is
# still read live (see driver_count), so the number never lies even in the
# demo.
# A hardware row: the DEVICE in the value colour, its DRIVER dim after a dim
# "·". Reads name-first, driver-as-footnote — you see what you have, then
# the proof it is handled, and the proof stays quiet.
hw_row() {                       # $1 label, $2 "name · driver — verdict"
  [ -n "$2" ] || return 0
  local rest=$2 verdict='' nm drv=''
  # A GPU row carries a " — verdict" tail (tested, working · driving this
  # screen / tested, didn't wake up). Split it off FIRST and always dim
  # it: the working verdict used to ride inside the dimmed driver segment
  # while the failing one — which has no driver, so no " · " to split on —
  # fell into the NAME and rendered undimmed (Max, round 4). Both dim now.
  case $rest in *" — "*) verdict=${rest#* — }; rest=${rest%% — *} ;; esac
  nm=${rest%% · *}
  [ "$rest" != "$nm" ] && drv=${rest#* · }
  printf '%s%s%s%s  %s%s%s' "$IND" "$C_TICK" "$TICK" "$NORM" \
    "$C_LABEL" "$(pad_to "${1^}" "$LABELW")" "$NORM"
  printf '%s%s%s' "$C_VALUE" "$nm" "$NORM"
  [ -n "$drv" ] && printf ' %s· %s%s' "$C_DIM" "$drv" "$NORM"
  [ -n "$verdict" ] && printf ' %s— %s%s' "$C_DIM" "$verdict" "$NORM"
  printf '\n'
}

hardware_reveal() {
  if [ "$FAKE_CENSUS" = yes ]; then
    hw_row GPU         "Intel Iris Xe Graphics · i915 — $(t gpu_scr)"
    hw_row "GPU 2"     "NVIDIA GeForce RTX 4050 Max-Q · nvidia — $(t gpu_use)"
    hw_row Wi-Fi       "Intel AX211 · iwlwifi"
    hw_row Ethernet    "Realtek RTL8111 · r8169"
    hw_row audio       "Realtek ALC287 · snd_hda_intel"
    hw_row Bluetooth   "Intel AX211 · btintel"
    hw_row fingerprint "Goodix Fingerprint Reader"
    hw_row touchpad    "ELAN · i2c-hid"
    return 0
  fi

  # lspci -k, one paragraph per device: the "Class:" line names it, a later
  # "Kernel driver in use:" names the module. Pull the three classes that
  # matter, each with its driver.
  local pci; pci=$(lspci -k 2>/dev/null || true)
  # One GPU row per display controller (see reveal_gpus): a hybrid shows
  # both its Intel iGPU and its AMD/nvidia dGPU, matching what is on the
  # case — primary first, each with its tested verdict (#17).
  reveal_gpus "$pci"
  hw_row Wi-Fi     "$(hw_pci "$pci" 'Network controller')"
  # Ethernet too, or a wired-only machine shows NO networking at all — the
  # Comodore has only a Marvell NIC and its whole network row was blank
  # (2026-09-06). "Network controller" is the PCI class for wireless; wired
  # is "Ethernet controller", a separate class.
  hw_row Ethernet  "$(hw_pci "$pci" 'Ethernet controller')"
  hw_row audio     "$(audio_row "$pci")"
  hw_row Bluetooth "$(hw_bt)"
  hw_row fingerprint "$(hw_input_fp)"
  # Touchpads are named by vendor, not by the word "touchpad": ALPS ships
  # "GlidePoint", so the old 'ouchpad|rackpad' pattern missed the Comodore's
  # pad entirely (2026-09-06). Match the common vendor names too. (A
  # capability probe — the input device with ABS axes + BTN_TOOL_FINGER —
  # would be fully robust; noted, not done.)
  # TWO TIERS (#21b): explicit pad names first — a ThinkPad carries an
  # "Elantech TrackPoint" AND an "Elantech Touchpad", and the vendor
  # pattern alone took whichever /proc listed first (the stick).
  local tp
  tp=$(hw_input '[Tt]ouch[Pp]ad|[Tt]rackpad|GlidePoint')
  [ -n "$tp" ] || tp=$(hw_input 'Synaptics|ALPS|Elan|Cypress')
  hw_row touchpad    "$tp"
  hw_row touchscreen "$(hw_input 'ouchscreen|ouch *[Ss]creen')"
}

# One device's "name · driver" from an lspci -k dump, FIRST match of $2.
#
# `lspci -k` puts NO blank line between devices — each device is a header
# line (bus id + class + name) followed by indented Subsystem/Kernel lines,
# then straight into the next header. The old parser looked for a blank
# line to end a device and otherwise fell to END, so it only ever kept the
# LAST device in the dump: on real hardware that meant Wi-Fi showed and the
# GPU/audio (earlier in the list) vanished (round 1, Acer). It also stripped
# the name with `^[^:]+: `, which the bus id's own colon (00:02.0) defeats —
# so the survivor rendered as "03:00.0 Network controller: …".
#
# This captures the first device whose header matches, taking everything
# after the FIRST ": " (colon-space — the bus id's colons have no space, so
# they are skipped) as the name, and the module from "Kernel driver in
# use:". The next header — or EOF — ends it. `exit` runs END, so END owns
# the single print; printing in the header rule too would double it.
#
# A chip newer than the medium's pci.ids has no name there and lspci
# prints "Intel Corporation Device 51cf" — the one row on the screen with
# a hex id where every other row has a name (Lenovo, round 4: the Raptor
# Lake audio codec). When the name ends in a bare "Device xxxx", the PCI
# class between the bus id and the colon stands in ("Intel Corporation
# Multimedia audio controller") — honest, and needs no ids update (R4-1).
# Same rule in hw_pci_all below, so every row is covered.
hw_pci() {
  printf '%s' "$1" | awk -v want="$2" '
    /^[0-9a-f]+:[0-9a-f]+/ {
      if (matched) exit
      if ($0 ~ want) {
        matched=1; line=$0; sub(/ \(rev [0-9a-f]+\)$/,"",line)
        i=index(line,": "); out=substr(line,i+2)
        if (out ~ /Device [0-9a-f][0-9a-f][0-9a-f][0-9a-f]$/) {
          cls=substr(line, length($1)+2, i-length($1)-2); sub(/ compatible/,"",cls)
          sub(/Device [0-9a-f]+$/, cls, out)
        }
      }
      next
    }
    matched && /Kernel driver in use:/ { out = out " \xc2\xb7 " $NF }
    END { if (matched) print out }'
}

# Like hw_pci but prints EVERY matching device, one per line — for the GPU
# row, because a switchable-graphics laptop has two and showing only the
# first (the Intel iGPU) while the lid wears a big red "AMD Radeon" sticker
# reads as "we don't know your hardware" (Max, round 2). One flush() per
# device boundary, so each match is emitted with its own driver. Each line
# leads with the bus id ("00:02.0|name · driver") so the caller can ask
# sysfs which card is boot_vga — the one driving the screen (#17).
hw_pci_all() {
  printf '%s' "$1" | awk -v want="$2" '
    function flush() { if (matched && out != "") print bus "|" out; matched=0; out="" }
    /^[0-9a-f]+:[0-9a-f]+/ {
      flush()
      if ($0 ~ want) {
        matched=1; line=$0; bus=$1; sub(/ \(rev [0-9a-f]+\)$/,"",line)
        i=index(line,": "); out=substr(line,i+2)
        if (out ~ /Device [0-9a-f][0-9a-f][0-9a-f][0-9a-f]$/) {
          cls=substr(line, length($1)+2, i-length($1)-2); sub(/ compatible/,"",cls)
          sub(/Device [0-9a-f]+$/, cls, out)
        }
      }
      next
    }
    matched && /Kernel driver in use:/ { out = out " \xc2\xb7 " $NF }
    END { flush() }'
}

# The audio row must name the SPEAKERS, not a GPU's display-audio
# function. Two different traps, so two filters (validated on the ASUS
# fixture + the ThinkPad):
#   - AMD APUs put the GPU, its HDMI/DP audio AND the real HD Audio all
#     on ONE slot (Renoir: 04:00.0 / .1 / .6), so a same-slot rule would
#     drop the speakers too — only the NAME splits them (#21a).
#   - Intel's integrated display audio sits at 00:03 beside the iGPU at
#     00:02 and is named plainly "…HD Audio Controller" (no "HDMI"), so
#     the name filter misses it and the row showed "Haswell-ULT HD
#     Audio" instead of the PCH codec at 00:1b (#21c, ASUS/Acer).
audio_row() {
  local all disp_slots bus rest slot preferred=''
  all=$(hw_pci_all "$1" 'Audio device|Multimedia audio')
  # bus:dev of every display controller (function stripped)
  disp_slots=$(hw_pci_all "$1" 'VGA|3D|Display' | sed 's/\..*//')
  while IFS='|' read -r bus rest; do
    [ -n "$bus" ] || continue
    slot=${bus%.*}
    case $rest in *HDMI*|*DisplayPort*|*'DP Audio'*) continue ;; esac
    if [ "$slot" = "00:03" ] && printf '%s\n' "$disp_slots" | grep -qx "00:02"; then
      continue
    fi
    preferred="$bus|$rest"; break
  done <<EOF
$all
EOF
  [ -n "$preferred" ] || preferred=$(printf '%s\n' "$all" | head -1)
  printf '%s' "${preferred#*|}"
}

# Long lspci names ("Intel Corporation Core Processor Integrated Graphics
# Controller", 55 chars) push the GPU verdict off an 80-col console — the
# verdict must always fit the line (#17 implementation note). Vendor word +
# the last [bracketed] product name, alternatives dropped; without brackets,
# the corporate noise words go.
gpu_short() {
  local n=$1 vend='' dev=''
  case $n in
    Intel*)    vend='Intel' ;;
    NVIDIA*)   vend='NVIDIA' ;;
    *AMD/ATI*) vend='AMD/ATI' ;;
  esac
  dev=$(printf '%s' "$n" | grep -o '\[[^][]*\]' | tail -1 | tr -d '[]' || true)
  [ "$dev" = 'AMD/ATI' ] && dev=''
  if [ -n "$dev" ]; then
    dev=${dev% / *}                                        # "… Max-Q / Mobile" → "… Max-Q"
    dev=$(printf '%s' "$dev" | sed -E 's|/[0-9][0-9A-Za-z-]*$||')  # "6370M/7370M" → "6370M"
  else
    dev=$(printf '%s' "$n" | sed -E \
      's/^(Intel|NVIDIA) Corporation //; s/^Advanced Micro Devices, Inc\. //; s/ Integrated / /; s/ Controller$//')
  fi
  if [ -n "$vend" ] && [ -n "$dev" ] && [ "${dev#"$vend"}" = "$dev" ]; then
    printf '%s %s' "$vend" "$dev"
  elif [ -n "$dev" ]; then printf '%s' "$dev"
  else printf '%s' "$n"; fi
}

# The GPU rows, with verdicts (#17, wording FINAL per Max 2026-09-07):
# the PRIMARY (boot_vga) card leads and reads "tested, working · driving
# this screen" — the strongest proof there is, you are reading its output.
# A second GPU shows by the audit's health verdict: working → the promise
# clause; failing → terse, and NO driver name (nothing drives a sleeping
# chip); unknown/ambiguous → the row says nothing beyond name · driver.
reveal_gpus() {
  local pci=$1 facts=/var/log/golem-audit/golem-hardware.nix
  local h='' bus g bv i pi=-1 n=1 short nm drv
  local -a RB=() RG=()
  [ -r "$facts" ] && h=$(grep -oE 'gpu2Health = "[a-z]+"' "$facts" 2>/dev/null | cut -d'"' -f2 || true)
  while IFS='|' read -r bus g; do
    [ -n "$g" ] || continue
    RB+=("$bus"); RG+=("$g")
  done < <(hw_pci_all "$pci" 'VGA|3D|Display')
  [ "${#RB[@]}" -gt 0 ] || return 0
  for i in "${!RB[@]}"; do
    bv=$(cat "/sys/bus/pci/devices/0000:${RB[$i]}/boot_vga" 2>/dev/null) || bv=''
    [ "$bv" = 1 ] && { pi=$i; break; }
  done
  [ "$pi" -lt 0 ] && pi=0
  g=${RG[$pi]}; nm=${g%% · *}; drv=''
  [ "$g" != "$nm" ] && drv=${g#* · }
  short=$(gpu_short "$nm")
  hw_row GPU "$short${drv:+ · $drv} — $(t gpu_scr)"
  # The reveal enumerates display controllers itself (live lspci), so it
  # needs #26's same-slot rule too, independently of the census: an
  # ancient GMA exposes 00:02.0 (VGA) AND 00:02.1 (a second display
  # function of the SAME chip), and without this the Comodore showed a
  # phantom "GPU 2" for its only GPU (round 4). Same PCI slot as the
  # primary (function stripped) = same silicon → skip.
  local pslot=${RB[$pi]%.*}
  for i in "${!RB[@]}"; do
    [ "$i" = "$pi" ] && continue
    [ "${RB[$i]%.*}" = "$pslot" ] && continue
    n=$(( n + 1 ))
    g=${RG[$i]}; nm=${g%% · *}; drv=''
    [ "$g" != "$nm" ] && drv=${g#* · }
    short=$(gpu_short "$nm")
    case $h in
      working) hw_row "GPU $n" "$short${drv:+ · $drv} — $(t gpu_use)" ;;
      failing) hw_row "GPU $n" "$short — $(t gpu_dead)" ;;
      *)       hw_row "GPU $n" "$short${drv:+ · $drv}" ;;
    esac
  done
}

hw_usb() {  # lsusb line for $1, trimmed to the vendor-product description
  lsusb 2>/dev/null | grep -m1 -i "$1" | sed -E 's/^.*[0-9a-f]{4}:[0-9a-f]{4} //' || true
}

# The Bluetooth radio, matched the way the CENSUS matches it: the sysfs
# bluetooth class (hci*), not `lsusb | grep Bluetooth`. Combo cards never
# say the word — the Acer's QCA9377 radio is a USB device lsusb labels only
# "Foxconn / Hon Hai", so the old grep found nothing while the census
# (sysfs ∨ rfkill ∨ USB class e0) correctly reported it present. The hci
# class is the census's own first leg. Name from the USB device's strings
# with an honest fallback; driver from the module bound to it (btusb).
hw_bt() {
  local hci real usbdev drv name
  for hci in /sys/class/bluetooth/hci*; do
    [ -e "$hci/device" ] || continue
    drv=$(basename "$(readlink -f "$hci/device/driver" 2>/dev/null)" 2>/dev/null)
    real=$(readlink -f "$hci/device" 2>/dev/null)
    usbdev=$(dirname "$real" 2>/dev/null)
    name=$(cat "$usbdev/product" 2>/dev/null)
    [ -n "$name" ] || name=$(cat "$usbdev/manufacturer" 2>/dev/null)
    [ -n "$name" ] || name="Bluetooth adapter"
    printf '%s%s' "$name" "${drv:+ · $drv}"
    return 0
  done
  return 0
}

hw_input() {  # a /proc input device whose Name matches $1 → "name · driver"
  # Round 1 returned just the Name, so the touchpad row had no "· driver"
  # while every other row did (Max, round 2). Pull the matching block's
  # Sysfs path too and walk UP it to the bound kernel driver (a touchpad's
  # driver — hid-multitouch, psmouse, i2c_hid — lives a few nodes above the
  # inputN leaf), so the row reads name-first, driver-as-footnote like the
  # rest. No driver found (rare) → just the name, as before.
  local devs=/proc/bus/input/devices line name sysfs p drv i
  [ -r "$devs" ] || return 0
  # A `found` flag, not `exit`: awk's exit runs END with n/s still set, so
  # exit-on-match double-prints and the second line corrupts $sysfs (the
  # same trap hw_pci hit in round 1). Guard both the blank-line print and
  # END; END covers a final block with no trailing blank line.
  line=$(awk -F'"' -v want="$1" '
    /^N: Name=/  { n=$2 }
    /^S: Sysfs=/ { s=substr($0,10) }
    /^$/ { if (!found && n ~ want && n != "") { print n "\t" s; found=1 } n=""; s="" }
    END  { if (!found && n ~ want && n != "") print n "\t" s }' "$devs" 2>/dev/null)
  [ -n "$line" ] || return 0
  name=${line%%$'\t'*}; sysfs=${line#*$'\t'}
  p="/sys$sysfs"
  for i in 1 2 3 4 5 6; do
    p=$(dirname "$p"); { [ "$p" = /sys ] || [ "$p" = / ]; } && break
    [ -e "$p/driver" ] && { drv=$(basename "$(readlink -f "$p/driver" 2>/dev/null)" 2>/dev/null); break; }
  done
  if [ -n "${drv:-}" ]; then printf '%s · %s' "$name" "$drv"; else printf '%s' "$name"; fi
}

# A fingerprint reader is a USB device by vendor id (the probe's own
# list). Shown like every other row — "name · driver", NO verdict (Max,
# round 3: "only show the name + the driver as the rest of the items").
# Most readers are driven by libfprint in USERSPACE with no kernel driver
# bound, so the driver half is usually absent and the row is name-only —
# that is honest and consistent (the pre-R3-1 touchpad read the same way).
# Walk sysfs for a bound kernel driver at the interface level (USB binds
# there), skipping the generic usbfs/usbhid, same idea as R3-1's touchpad.
hw_input_fp() {
  local d vid name drv i
  for d in /sys/bus/usb/devices/*; do
    [ -r "$d/idVendor" ] || continue
    vid=$(cat "$d/idVendor" 2>/dev/null)
    case $vid in 138a|06cb|27c6) ;; *) continue ;; esac
    name=$(cat "$d/product" 2>/dev/null)
    [ -n "$name" ] || name=$(lsusb -d "$vid:$(cat "$d/idProduct" 2>/dev/null)" 2>/dev/null \
      | sed -E 's/^.*[0-9a-f]{4}:[0-9a-f]{4} //')
    [ -n "$name" ] || continue
    drv=''
    for i in "$d":*; do
      [ -e "$i/driver" ] || continue
      drv=$(basename "$(readlink "$i/driver")")
      case $drv in usbfs|usbhid|'') drv='' ;; *) break ;; esac
    done
    [ -n "$drv" ] && printf '%s \xc2\xb7 %s' "$name" "$drv" || printf '%s' "$name"
    return 0
  done
}

# ── the count, ALWAYS real ────────────────────────────────────────────────
#
# devices with a bound kernel driver, over all PCI+USB devices. Read live
# even under --fake-disks: the demo shows a canned hardware LIST but a true
# NUMBER, because a percentage nobody can check is the one thing on this
# screen that would poison the trust it exists to build. On a fully
# supported machine it reads "N of N (100%)"; on one with an oddball it
# reads less, and names nothing it cannot back up.
# THE DRIVER PROBE RUNS WHILE THE QUESTIONS ARE ANSWERED (Max, 2026-09-06).
# Reading every device and matching a driver is real work; done at the
# confirm screen it would either freeze for a beat or, worse, feel instant
# and therefore fake. So it is kicked off at the START of the installer and
# lands in a file — by the time anyone has typed a hostname and a password
# it is long finished, and the reveal reads it with no wait. The census does
# exactly this behind the keyboard step; this is the same trick for drivers.
DRV_FILE=''
PROBE_PID=''
probe_compute() {                # the honest count — devices with a driver
  # Emits NUMBERS ("have total"), never a sentence: this runs at startup,
  # while UI is still the English default, and a sentence rendered here is
  # baked in before any language is chosen — the Spanish run's one English
  # line (round 2, HP photo; #18a). render_drv turns the numbers into the
  # translated sentence at display time.
  local total have
  if command -v lspci >/dev/null 2>&1; then
    # Count PERIPHERALS, not chipset glue. PCI bridge-class devices (class
    # 0x06xx: host bridge, PCI/ISA bridge, QPI registers) NEVER bind a
    # driver on any OS and are not hardware a person thinks about — the HP
    # read "23/31 (74%)" purely because its 8 QPI/bridge registers sat in
    # the denominator (round 2). Exclude class 06xx from both totals via
    # `lspci -nk` (numeric class in $2), so the ratio reflects real devices.
    local pci; pci=$(lspci -nk 2>/dev/null)
    total=$(printf '%s\n' "$pci" | awk '/^[0-9a-f]+:[0-9a-f]+/ && $2 !~ /^06/ {n++} END{print n+0}')
    have=$(printf '%s\n' "$pci" | awk '
      function flush() { if (per && drv) h++; per=0; drv=0 }
      /^[0-9a-f]+:[0-9a-f]+/ { flush(); per=($2 !~ /^06/) }
      /Kernel driver in use:/ { drv=1 }
      END { flush(); print h+0 }')
  fi
  if [ -d /sys/bus/usb/devices ]; then
    local u ut=0 uh=0
    for u in /sys/bus/usb/devices/*/; do
      case ${u##*/devices/} in *:*) continue ;; esac   # skip interfaces
      [ -r "$u/idVendor" ] || continue
      ut=$(( ut + 1 )); [ -e "$u/driver" ] && uh=$(( uh + 1 ))
    done
    total=$(( ${total:-0} + ut )); have=$(( ${have:-0} + uh ))
  fi
  printf '%s %s\n' "${have:-0}" "${total:-0}"
}
render_drv() {                   # numbers → the sentence, in the CURRENT language
  local have=${1:-0} total=${2:-0}
  [ "$total" -gt 0 ] || { t drv_none; return; }
  t drv_line | sed -e "s/%h/$have/" -e "s/%t/$total/" -e "s/%p/$(( have * 100 / total ))/"
}
probe_start() {
  DRV_FILE=$(mktemp "${TMPDIR:-/tmp}/golem-drv.XXXXXX")
  {
    # In the demo the real lspci is instant, so simulate the seconds the
    # probe genuinely takes on a 2015 laptop — the point is that the work
    # overlaps the questions, and a demo with zero delay would not show it.
    [ "$FAKE_CENSUS" = yes ] && sleep "${GOLEM_PROBE_SLEEP:-3}"
    probe_compute > "$DRV_FILE"
  } &
  PROBE_PID=$!
}
# Read the result; if the probe is somehow still running (a very fast
# tester), block on it — the caller shows a word first so it is not a freeze.
driver_count() {
  [ -n "$PROBE_PID" ] && wait "$PROBE_PID" 2>/dev/null
  local nums
  nums=$(cat "$DRV_FILE" 2>/dev/null) || nums=''
  [ -n "$nums" ] || nums=$(probe_compute)
  # word-splitting the two cached numbers is the point here
  # shellcheck disable=SC2086
  render_drv $nums
}

# One line, redrawn in place:
#   ████████████░░░░░░░░░░░░░░░░  43%   Copying Golem
#
# Solid blocks in the accent for done, light shade in dim for the rest —
# the same accent/dim ramp the whole surface uses, so the bar is not a
# different visual language, just the one accent doing progress. A percent
# reads more finished than "3/6" and does not make anyone do the fraction in
# their head, and the phase name says what the wait is FOR — a bar with no
# caption is a spinner, and a spinner is the thing this installer refuses to
# make anyone watch. tr is byte-based and would mangle the multibyte blocks,
# so the runs are built with a space-fill and a parameter-expansion swap.
paint_bar() {                    # $1 cur  $2 max  $3 label
  local w=28 fill f e pct
  fill=$(( $1 * w / $2 )); pct=$(( $1 * 100 / $2 ))
  f=$(printf "%${fill}s" ''); f=${f// /█}
  e=$(printf "%$(( w - fill ))s" ''); e=${e// /░}
  printf '\r%s[2K%s%s%s%s%s%s   %s%3d%%%s   %s%s%s' "$esc" "$IND" \
    "$C_ACCENT" "$f" "$C_DIM" "$e" "$NORM" \
    "$C_VALUE" "$pct" "$NORM" \
    "$C_DIM" "${3^}" "$NORM"
  return 0
}

# ── the developer install, behind a hidden Ctrl+D ────────────────────────
#
# Ctrl+D on the confirm screen opens THIS, and nothing advertises it — a
# stranger never finds it, and someone who knows to reach for it is by
# definition not a stranger. What lies past the disclaimer is not built yet;
# this is only the gate, and the gate's whole job is to make sure a curious
# tourist who pressed TAB by accident lands somewhere that says "not for
# you" and offers one calm way back.
#
# The one option is a real selectable row (accent, highlighted) so the way
# out is obvious and deliberate; ENTER on it and ESC both return. When the
# actual developer flow is built, this list grows a second row above "Take
# me away" and the return-value tells step_go which was chosen.
dev_gate() {
  screen
  hide_cursor
  printf '\n%s%s%s%s\n\n' "$IND" "$C_RED" "$(t dev_title)" "$NORM"
  # Word-wrap the body at 64 columns so it breaks at spaces, not mid-word —
  # the terminal's own wrap splits "installation" across a line boundary,
  # which on a warning is the one place it must not look careless.
  printf '%s\n' "$(t dev_body)" | fold -s -w 64 | while IFS= read -r l; do
    printf '%s%s%s%s\n' "$IND" "$C_ASK" "$l" "$NORM"
  done
  printf '\n'
  printf '%s  %s%s %s%s%s\n' "$IND" "$C_ACCENT" "$CARET" \
    "$C_ACCENT_TX" "$(t dev_away)" "$NORM"
  printf '\n%s%s%s%s\n' "$IND" "$C_DIM" "$(t dev_keys)" "$NORM"
  while :; do
    read_key || continue
    case $KEY in
      ENTER|ESC) break ;;   # only one option, so both leave
      *) ;;
    esac
  done
  return 0
}

step_go() {
  # The answers are written BEFORE the question is asked: ENTER hands them
  # straight to golem-install, and someone who backs out of the confirm
  # still leaves a complete answers file behind — which is exactly what the
  # lab's SSH-driven half wants to find.
  [ -n "$OUT" ] && write_answers "$OUT"
  [ -n "$WRITE" ] && write_module "$WRITE"
  screen; stack
  hide_cursor
  # THE COUNT LINE IS GONE (Max, round 3, on the Comodore's "25 of 26"):
  # every sub-100% the lab ever chased was phantom or dormant silicon
  # (IOMMU, a declining ACP, a dead sibling display function) — the score
  # graded a test whose missing points don't exist as hardware, and its
  # only products were anxiety and a Google query ("i need that one to
  # be complete!"). The hardware ROWS are the proof; Golem does not
  # grade itself. The probe still runs at launch — its numbers sit in
  # $DRV_FILE for a lab hand over SSH, never on the stranger's screen.
  while :; do
    screen; stack
    census_reveal
    printf '\n%s%s%s%s\n\n' "$IND" "$C_ASK" "$(t t_go)" "$NORM"
    # The last page: ENTER installs, ESC steps back, F1 abandons the whole
    # thing (the round-4 escape hatch — Max: the installer had no way out).
    printf '%s%s%s  ·  %s%s\n' "$IND" "$C_DIM" "$(t go_keys)" "$(t key_cancel)" "$NORM"
    read_key || continue
    case $KEY in
      ENTER) break ;;
      ESC)   return 1 ;;
      F1)    cancel_install ;;
      # Ctrl+D is the hidden door — never on the guide line, never
      # announced. It opens the developer disclaimer; whatever that returns,
      # we come back to redraw the confirm and wait again.
      DEV)   dev_gate ;;
      *)     ;;
    esac
  done

  # The question is answered; the guide line becomes the bar.
  printf '%s[1A\r%s[2K' "$esc" "$esc"
  local cmd line rest frac cur max label rc=0 done=no prepared=no
  local rehearsed=no findings="" addr=""
  if [ "$FAKE_INSTALL" = yes ]; then
    cmd='for p in "1/6 format" "2/6 fs" "3/6 seed" "4/6 probe" "5/6 install" "6/6 done"; do echo "##golem $p"; sleep 0.6; done'
  else
    # The surface runs as root on the medium (helpLine says sudo); the
    # answers file already carries every choice, including the LUKS
    # keyfile path when encryption was chosen in Advanced.
    #
    # THE MODE LADDER, one env line per rung (Max, 2026-09-06: test the
    # whole process on the five laptops before wiring the real install):
    #
    #   GOLEM_REHEARSE=1  --rehearse: the same installer with the
    #                     destructive verbs recorded instead of run. It
    #                     leaves a bundle in /var/log/golem-rehearsal for
    #                     the dev box to audit over SSH, and it WINS over
    #                     GOLEM_LAB — while the lab rehearses, pressing
    #                     ENTER on a lab machine must not be able to reach
    #                     a disk.
    #   GOLEM_LAB=1       --prepare-only: the real install's first half.
    #                     A full run would build the 18.8 GiB closure into
    #                     the medium's tmpfs store — RAM — which on the
    #                     4 GB class this lab exists for is not slow, it
    #                     is fatal; the closure is delivered from the dev
    #                     box between the halves.
    #   neither           the full install; deleting the env lines from
    #                     setup.nix is the day the bar runs to 6/6 on a
    #                     stranger's machine.
    cmd="golem-install --answers ${OUT:-/tmp/golem-answers} --disk $DISK_TARGET --yes"
    if [ "${GOLEM_REHEARSE:-0}" = 1 ]; then
      cmd="$cmd --rehearse"
    elif [ "${GOLEM_LAB:-0}" = 1 ]; then
      cmd="$cmd --prepare-only"
    fi
  fi
  INSTALL_LAUNCHED=yes
  while IFS= read -r line; do
    case $line in
      '##golem prepared')
        prepared=yes ;;
      # BEFORE the generic arm, load-bearing: "rehearsed 0" parsed as a
      # fraction would read cur==max — the reboot trigger — and restart a
      # machine with no system on it.
      '##golem rehearsed'*)
        rehearsed=yes
        findings=${line#\#\#golem rehearsed}; findings=${findings# }
        # Fill the bar to 100%. Rehearse emits up to 5/6 (83%) then this
        # marker — never 6/6, which is the reboot trigger — so without this
        # the bar sits at 83% and reads as stuck (round 1, Acer). The label
        # says "rehearsed" — translated (#18: it read English over an
        # otherwise fully-Spanish bar) — so a full bar is not mistaken
        # for an install.
        paint_bar "${max:-1}" "${max:-1}" "$(t reh_bar)" ;;
      '##golem '*)
        # marker: "##golem <cur>/<max> <key>" — the engine sends a phase
        # KEY, and the surface renders it in the chosen language (#18b:
        # literal label text in the protocol painted English onto a
        # Spanish run). Unknown text passes through untouched, so an old
        # engine or a phrase-style marker still draws something.
        rest=${line#\#\#golem }
        frac=${rest%% *}; cur=${frac%%/*}; max=${frac##*/}; label=${rest#* }
        case $label in
          format)  label=$(t ph_format) ;;
          fs)      label=$(t ph_fs) ;;
          seed)    label=$(t ph_seed) ;;
          probe)   label=$(t ph_probe) ;;
          eval)    label=$(t ph_eval) ;;
          install) label=$(t go_ing) ;;
        esac
        # Done is cur==max, not a magic word — the final phase reads
        # "Installed" in the owner's language, and this is the reboot trigger.
        [ "$cur" = "$max" ] && { label=$(t go_done); done=yes; }
        paint_bar "$cur" "$max" "$label" ;;
      *) ;;                      # the log itself stays off the screen —
                                 # it is on the terminal scrollback if a
                                 # phase dies and someone needs it
    esac
  done < <(eval "$cmd" 2>&1) || rc=1

  printf '\n'
  if [ "$done" = yes ]; then
    # No "restarting…" line: the full bar IS the signal, and the reboot is
    # immediate at 100% (Max, 2026-09-06). The machine goes down mid-breath
    # — the last thing on screen is a complete bar reading "Installed", and
    # the next thing is Golem. A message announcing a reboot that happens
    # the same instant is a message nobody finishes reading. The fake path
    # has nothing to reboot, so it just leaves the full bar up.
    show_cursor
    [ "$FAKE_INSTALL" = yes ] || systemctl reboot
    return 0
  fi
  if [ "$prepared" = yes ]; then
    # The lab seam, not a failure: the disk is ready and waiting for the
    # closure from the dev box. Lab-facing, so untranslated like handoff.
    printf '%s%sprepared — deliver the closure, then:%s\n' "$IND" "$C_DIM" "$NORM"
    printf '%s%ssudo golem-install --disk %s --owner %s --skip-prepare --system PATH%s\n' \
      "$IND" "$C_VALUE" "$DISK_TARGET" "${OWNER:-max}" "$NORM"
    show_cursor
    return 0
  fi
  if [ "$rehearsed" = yes ]; then
    # The rehearsal outcome: the whole flow ran, nothing touched the disk,
    # and the machine is holding a bundle for the dev box to audit. The
    # outcome line is TRANSLATED (#18c — it rendered English on a Spanish
    # run, and a rehearsal is exactly the run a curious stranger tries);
    # the report path and ssh line below stay lab-facing and literal.
    # The IP is printed because the very next thing that happens is an
    # SSH from across the room.
    if [ "${findings:-0}" = 0 ]; then
      printf '%s%s%s%s\n' "$IND" "$C_DIM" "$(t reh_none)" "$NORM"
    else
      printf '%s%s%s%s\n' "$IND" "$C_ACCENT" "$(t reh_find | sed "s/%s/$findings/")" "$NORM"
    fi
    printf '%s%sreport: /var/log/golem-rehearsal  (checks.txt first)%s\n' \
      "$IND" "$C_VALUE" "$NORM"
    if command -v ip >/dev/null 2>&1; then
      addr=$(ip -4 -o addr show scope global 2>/dev/null | awk '{print $4}' | cut -d/ -f1 | head -1)
      [ -n "$addr" ] && printf '%s%sfrom the dev box: ssh root@%s%s\n' \
        "$IND" "$C_DIM" "$addr" "$NORM"
    fi
    show_cursor
    return 0
  fi
  printf '%s%s%s%s\n' "$IND" "$C_ACCENT" "$(t go_fail)" "$NORM"
  show_cursor
  return 0
}

# ══ THE ANSWERS, ON THEIR WAY OUT ════════════════════════════════════════
#
# Until now the derivation could only be LOOKED at (--dump settings). This
# is how it leaves: a shell fragment the install flow sources, so the
# surface and `golem-install` share one vocabulary instead of a shell
# pipeline that reassembles flags by hand.
#
#   ./install-cli --out /tmp/answers
#   . /tmp/answers
#   golem-install --disk /dev/sda \
#     --locale     "$GOLEM_LOCALE" \
#     --kb-layout  "$GOLEM_KB_LAYOUT"  --kb-variant "$GOLEM_KB_VARIANT" \
#     --kb-options "$GOLEM_KB_OPTIONS" --kb-model   "$GOLEM_KB_MODEL" \
#     --kb-console "$GOLEM_KB_CONSOLE" --kb-font    "$GOLEM_KB_FONT"
#
# %q, not bare interpolation: `grp:alt_shift_toggle` is harmless but the
# comma in "ru,us" and the lone "," variant are exactly the shapes that
# turn into two words the first time somebody forgets a quote.
# The keyboard, set up. Not described, not handed to somebody else to plumb
# — written as the module the machine imports, the way you would have
# written it by hand.
write_module() {
  local f=$1
  kb_derive "$KB_ROW"
  {
    printf '# Written by the Golem installer.\n'
    printf '{ ... }:\n{\n'
    printf '  golem.locale.defaultLocale = "%s";\n' "${LOCALE[$LANG_ROW]}"
    printf '  golem.locale.timeZone = "%s";\n\n' "$TZ_ZONE"
    if [ -n "${OWNER:-}" ]; then
      printf '  golem.owner = "%s";\n' "$OWNER"
      printf '  networking.hostName = "%s";\n' "$HOSTNAME_V"
      [ -n "${PASS_HASH:-}" ] && [ "$PASS_HASH" != '!unhashed' ] &&
        printf '  users.users.%s.hashedPassword = "%s";\n' "$OWNER" "$PASS_HASH"
      printf '\n'
    fi
    printf '  golem.keyboard = {\n'
    printf '    layout = "%s";\n'        "$KB_LAYOUT"
    printf '    variant = "%s";\n'       "$KB_VARIANT"
    printf '    options = "%s";\n'       "$KB_OPTIONS"
    printf '    model = "%s";\n'         "$KB_MODEL"
    printf '    consoleKeyMap = "%s";\n' "$KB_CONSOLE"
    [ -n "$KB_FONT" ] && printf '    consoleFont = "%s";\n' "$KB_FONT"
    printf '  };\n}\n'
  } > "$f"
}

write_answers() {
  local f=$1
  kb_derive "$KB_ROW"
  {
    printf '# written by install-cli — the installer surface answers\n'
    printf 'GOLEM_LANG=%q\n'       "${CODE[$LANG_ROW]}"
    printf 'GOLEM_LOCALE=%q\n'     "${LOCALE[$LANG_ROW]}"
    printf 'GOLEM_TIMEZONE=%q\n'   "$TZ_ZONE"
    printf 'GOLEM_DISK=%q\n'       "${DISK_TARGET:-}"
    printf 'GOLEM_LUKS=%q\n'       "${LUKS:-no}"
    # The PATH to the passphrase, never the passphrase. cryptsetup needs the
    # real thing to format a container so it cannot be hashed like the
    # account password — it lives in a 0600 file on tmpfs (RAM, never a
    # disk) and golem-install shreds it as soon as the container exists.
    printf 'GOLEM_LUKS_KEYFILE=%q\n' "${LUKS_KEYFILE:-}"
    printf 'GOLEM_OWNER=%q\n'      "${OWNER:-}"
    printf 'GOLEM_HOSTNAME=%q\n'   "${HOSTNAME_V:-}"
    # The HASH, never the password. This file is written to a tmpfs on the
    # medium and handed to golem-install; a plaintext password in it would
    # outlive the screen that promised it would not be stored as text.
    printf 'GOLEM_PASS_HASH=%q\n'  "${PASS_HASH:-}"
    printf 'GOLEM_KB_ID=%q\n'      "${KB_ID[$KB_ROW]}"
    printf 'GOLEM_KB_LAYOUT=%q\n'  "$KB_LAYOUT"
    printf 'GOLEM_KB_VARIANT=%q\n' "$KB_VARIANT"
    printf 'GOLEM_KB_OPTIONS=%q\n' "$KB_OPTIONS"
    printf 'GOLEM_KB_MODEL=%q\n'   "$KB_MODEL"
    printf 'GOLEM_KB_CONSOLE=%q\n' "$KB_CONSOLE"
    printf 'GOLEM_KB_FONT=%q\n'    "$KB_FONT"
    # Whether the keymap the user confirmed is actually loaded right now.
    # The disk step needs to know: a passphrase typed under an unapplied
    # keymap is the lockout PLAN.md orders these steps to prevent.
    printf 'GOLEM_KB_APPLIED=%q\n' "$KB_APPLIED"
  } > "$f"
}

# ══ WHERE THE MOCKUP STOPS ═══════════════════════════════════════════════
#
# Step 3 is EVALUATION — what Golem found and what it will build. It is the
# census, which has been running since boot and by now is finished: the
# ordered sections decide.nix already returns, printed as they come. When it
# exists it will open with screen() like the other two and this goes away.
#
# Until then the run has to end somewhere, so it ends by naming the step it
# would open and what the two answered steps settled. That is an EXIT REPORT
# for whoever is driving the mockup, not a screen — no installer ever shows
# it, which is why it is dim and sits under the fold rather than being drawn
# like a step.
handoff() {
  screen; stack
  printf '%s%s%s%s  %s%s%s\n\n' "$IND" "$C_DIM" "$(t next)" "$NORM" \
    "$C_DIM" "$(t l_evaluation)" "$NORM"
  # THE LAB JOIN. Until the evaluation+install screens exist, the surface's
  # answers must not evaporate with the screen: when --out was given (the
  # packaged golem-setup always gives it), say where the answers landed and
  # print the exact command that consumes them. Untranslated on purpose —
  # this is the seam where the built half of the flow hands over to the
  # not-yet-built half, and it speaks to whoever is driving the lab, not to
  # a stranger. It disappears when step 6 lands.
  if [ -n "$OUT" ]; then
    printf '%s%sanswers: %s%s\n' "$IND" "$C_DIM" "$OUT" "$NORM"
    printf '%s%ssudo golem-install --answers %s --disk %s%s\n\n' \
      "$IND" "$C_VALUE" "$OUT" "${DISK_TARGET:-<disk>}" "$NORM"
  fi
}

# ══ RUN ══════════════════════════════════════════════════════════════════

SECONDS_PER=4
ASCII=no
DUMP=''
PRESET=''
KB_PRESET=''
LOADKEYS=try
OUT=""
DISK_TARGET=""
FAKE_DISKS=no
WRITE=""
CHECK=no
VERIFY_KBD='' VERIFY_XKB=''
TTY=no
KB_ROW=0
# Gated on STDOUT only. Clearing the screen, hiding the cursor and drawing
# the cursor block are all things done TO THE DISPLAY, so whether stdin
# happens to be a pipe is none of their business — and gating on stdin too
# meant the dump and key-driven runs could never exercise the clear.
[ -t 1 ] && TTY=yes
# fbcon cannot shape, so the console gets Latin names unless told otherwise
[ "${TERM:-}" = linux ] && ASCII=yes

while [ $# -gt 0 ]; do
  case $1 in
    --lang)     PRESET="${2:?}"; shift 2 ;;
    --kb)       KB_PRESET="${2:?}"; shift 2 ;;
    --tz)       TZ_ZONE="${2:?}"; shift 2 ;;
    --form)     FORM="${2:?}"; shift 2 ;;
    --seconds)  SECONDS_PER="${2:?}"; shift 2 ;;
    --census)   CENSUS_SECONDS="${2:?}"; shift 2 ;;
    --fake-disks) FAKE_DISKS=yes; shift ;;
    --fake-census)  FAKE_CENSUS=yes; shift ;;
    --fake-install) FAKE_INSTALL=yes; shift ;;
    --no-loadkeys) LOADKEYS=no; shift ;;
    --out)      OUT="${2:?}"; shift 2 ;;
    --write)    WRITE="${2:?}"; shift 2 ;;
    --ascii)    ASCII=yes; shift ;;
    --endonym)  ASCII=no; shift ;;
    --dump)     DUMP="${2:?}"; TTY=no; shift 2 ;;
    --rot)      ROT="${2:?}"; shift 2 ;;
    --query)    QUERY="${2-}"; shift 2 ;;
    --check)    CHECK=yes; shift ;;
    --table)    printf '%s\n' "$KEYBOARDS"; exit 0 ;;
    --verify)   VERIFY_KBD="${2:?}"; VERIFY_XKB="${3:?}"; shift 3 ;;
    -h|--help)  sed -n '2,40p' "$0"; exit 0 ;;
    *)          echo "install-cli: unknown argument '$1'" >&2; exit 2 ;;
  esac
done

# --fake-disks IS THE DEMO FLAG (Max, 2026-09-06: "we were designing it with
# --fake-disks, I want to see the whole process, faked"). A machine with no
# disk to install to also has no boot-audit census to reveal and no real
# golem-install to drive the bar, so on a dev box it implies both fakes —
# the whole flow, all the way to "restarting into Golem", off one flag.
# Naming --fake-census or --fake-install explicitly still lets you mix; this
# only fills the ones left at their default.
if [ "$FAKE_DISKS" = yes ]; then
  [ "$FAKE_CENSUS" = no ]  && FAKE_CENSUS=yes
  [ "$FAKE_INSTALL" = no ] && FAKE_INSTALL=yes
fi

# The invitation rotates through welcomes in many scripts — but fbcon has
# no glyphs for CJK/Arabic/Cyrillic, so on the bare console (ASCII=yes,
# TERM=linux) those lines render as boxes with a lone "ENTER" in the middle
# (Max saw the zh-CN line, 2026-09-06). The list already goes Latin on the
# console; the invitation must too. Keep only the PURE-ASCII welcomes there
# (en/es/fr/pt/it/id + the already-romanized hi) so every rotation renders —
# testing bytes, not a per-language flag, so a new native welcome is handled
# without being marked. Off-console (ASCII=no) the full set rotates, native
# scripts and all, on a terminal that can draw them.
if [ "$ASCII" = yes ]; then
  _inv=()
  for _e in "${INVITE[@]}"; do
    printf '%s' "${_e#*|}" | LC_ALL=C grep -q '[^ -~]' || _inv+=("$_e")
  done
  INVITE=("${_inv[@]}")
fi

# Both settled once ASCII is known, so nothing on the hot path forks to work
# out what a row is called.
EN_ROW=$(index_of_code en)
DISPLAY=()
for (( i = 0; i < NROWS; i++ )); do DISPLAY+=("$(name_of "$i")"); done

[ -n "$VERIFY_KBD" ] && { kb_verify "$VERIFY_KBD" "$VERIFY_XKB"; exit $?; }
[ "$CHECK" = yes ] && { str_check && kb_check; exit $?; }

LANG_ROW=$(index_of_code "${PRESET:-en}")
take_language() {                # --lang: settle step 1 without asking
  UI=${CODE[$LANG_ROW]}
  settle "$(t l_language)" "${DISPLAY[$LANG_ROW]}" "${LOCALE[$LANG_ROW]}"
}

# A dump shows ONE step exactly as that step looks — stack included, since
# the stack IS part of the screen. take_language settles step 1 so the later
# dumps carry the item the real run would have put there.
case "$DUMP" in
  invite)
    screen; paint_invite; printf '\n\n'; exit 0 ;;
  filter)
    screen
    lang_view "$(index_of_code "${INVITE[$ROT]%%|*}")"
    pick_seed; paint_pick; printf '%s[%dB\n' "$esc" "$BLOCK"; exit 0 ;;
  keyboard|layouts)
    take_language; screen; stack
    # Same precedence as the live step: --kb wins, then the timezone's
    # country, then the language.
    kb_seed_id=${KB_PRESET:-$(kb_for_country "$(tz_country "$TZ_ZONE")")}
    mapfile -t KB_VIEW < <(kb_order "$(kb_index "${kb_seed_id:-${KEYMAP[$LANG_ROW]}}")")
    PICK_NAME=(); PICK_HAY=(); PICK_NOUN=$(t l_keyboard); PICK_TITLE=$(t t_keyboard)
    for i in "${KB_VIEW[@]}"; do
      PICK_NAME+=("${KB_NAME[$i]}"); PICK_HAY+=("${KB_HAY[$i]}")
    done
    SEED=0
    pick_seed; paint_pick; printf '%s[%dB\n' "$esc" "$BLOCK"; exit 0 ;;
  done)
    take_language
    KB_ROW=$(kb_index "${KB_PRESET:-${KEYMAP[$LANG_ROW]}}")
    settle "$(t l_keyboard)" "${KB_NAME[$KB_ROW]}" "$(kb_aside "$KB_ROW")"
    handoff; exit 0 ;;
  settings)
    KB_ROW=$(kb_index "${KB_PRESET:-${KEYMAP[$LANG_ROW]}}")
    printf '# %s\n' "${KB_NAME[$KB_ROW]}"
    kb_emit "$KB_ROW"; exit 0 ;;
  '') ;;
  *)  echo "install-cli: --dump wants invite | filter | keyboard | layouts | done | settings" >&2
      exit 2 ;;
esac

# Claim the console so the boot audit's completion banner does not dump
# on top of this UI on a slow machine (#28). The marker is best-effort:
# on a demo/dev box it may be unwritable and there is no audit anyway.
: > /run/golem-setup.owns-console 2>/dev/null || true

# Quitting before an install ran gives the tty its keymap back (#7);
# once the engine has been launched the chosen keymap is the machine's.
#
# The cleanup hangs on EXIT ONLY. It used to be one handler for
# `EXIT INT TERM`, and a trap handler does not exit by itself — on Ctrl-C
# bash ran it and carried on, so the UI stayed up with its cleanup already
# spent: the #28 console marker gone (an audit banner then landed on tty1,
# live, Lenovo round 4), the keymap backup deleted so the real exit had
# nothing to restore (#7 through a side door), cursor shown over raw
# mode. Ctrl-C now means what F1 means: leave, once, cleanly (#34).
INSTALL_LAUNCHED=no
cleanup() {
  show_cursor; printf "\n"
  [ "$INSTALL_LAUNCHED" = yes ] || kb_restore
  [ -n "$KB_ORIG" ] && rm -f "$KB_ORIG"
  [ -n "$DRV_FILE" ] && rm -f "$DRV_FILE"
  rm -f /run/golem-setup.owns-console 2>/dev/null || true
}
trap cleanup EXIT
trap cancel_install INT TERM

# The installer owns this screen now — but at the console's default
# loglevel the kernel still paints err-level lines over the surface (the
# HP's sleeping Radeon fails every runtime resume and says so, in red,
# mid-reveal). Crit-and-worse only; dmesg and the journal keep the rest.
# Root on a real VT only, so demo runs in a terminal stay hands-off.
case $(tty 2>/dev/null) in
  /dev/tty[0-9]*) [ "$(id -u)" = 0 ] && dmesg -n 3 || : ;;
esac

# ── the step machine ─────────────────────────────────────────────────────
#
# A step returns 0 to go on and 1 to go BACK, and the loop below is the only
# thing that knows which step follows which. Before running step i the stack
# is truncated to the height it had when step i was first entered, so going
# back does not just re-ask the question — it removes the answer, and the
# stack stops claiming a thing that is about to be decided again.
#
# Step 0 cannot go back to anywhere, so a 1 from it simply re-runs it.
STEPS=(step_language step_timezone step_keyboard step_disk step_you step_go)
[ -n "$PRESET" ] && { take_language; STEPS=(step_timezone step_keyboard step_disk step_you step_go); }

# The height BEFORE step 0 runs — not zero. With --lang, take_language has
# already put the language on the stack, and starting the depths at 0 made
# the loop truncate ITEMS to nothing on the very first iteration: the
# language row vanished and every later screen was missing it. Nothing
# failed; the stack was just quietly one line short.
probe_start
declare -a STEP_DEPTH=("${#ITEMS[@]}")
si=0
while (( si < ${#STEPS[@]} )); do
  ITEMS=("${ITEMS[@]:0:${STEP_DEPTH[$si]}}")
  if "${STEPS[$si]}"; then
    si=$(( si + 1 ))
    STEP_DEPTH[$si]=${#ITEMS[@]}
  else
    # step_disk returns 1 both for "go back" and for "this machine has no
    # disk", and the second is fatal — it says so on screen and there is
    # nothing behind it to fix.
    [ "${STEPS[$si]}" = step_disk ] && [ -z "$DISK_TARGET" ] &&
      (( ${#DISK_DEV[@]} == 0 )) && exit 1
    (( si > 0 )) && si=$(( si - 1 ))
  fi
done
# step_go is the last step and owns the ending — the reveal, the bar, the
# reboot. There is nothing left to hand off to; the old `handoff` screen
# (a stub that named the not-yet-built evaluation) is gone with it.
