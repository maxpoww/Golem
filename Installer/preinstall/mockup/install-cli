#!/usr/bin/env bash
# ─────────────────────────────────────────────────────────────────────────
# Golem installer — the CLI chat. Nothing here detects or installs yet.
#
# Replaces the TUI mockup (`census-mock`). Same guidelines, no grid: the
# installer is a CONVERSATION that scrolls, not a screen that is painted.
# Three rules, in this order (Max, 2026-09-05):
#
#   SIMPLE   one question on screen at a time; answered ones collapse to a
#            single line and stay as the transcript. No boxes, no tiles, no
#            layout(). The terminal does the wrapping, so there is no cell
#            grid to be wrong about — which retires census-mock's KNOWN
#            DEFECT (one cell per code point) rather than working around it.
#   FASTER   the whole language step is ENTER, two or three letters, ENTER;
#            the keyboard step is usually one ENTER, because step 1 already
#            answered it. Typing during the invitation goes straight into
#            the list, so nobody who knows what they want waits 5 s.
#   COMPLETE both lists are the real ones — 61 languages, 72 layouts — and
#            a step is not done when it has been ASKED, it is done when the
#            answer produces every setting an installed machine needs. The
#            keyboard step asks one question and derives the console keymap,
#            the XKB layout/variant/options and Hyprland's own input block
#            from it. Colemak, Dvorak, Neo, Bépo, US-International and
#            Turkish-F are reachable; non-Latin scripts get a second Latin
#            group and a toggle, without being asked. See `--dump settings`.
#
# The steps, in the order PLAN.md argues for:
#
#   1  language    the rotating invitation, then a filtered list
#   2  keyboard    step 1's default, plus a live echo box to prove it
#   3  evaluation  what the census found — next
#
#   ./install-cli                    run it
#   ./install-cli --lang es          skip step 1 (records es, moves on)
#   ./install-cli --kb latam         start step 2 on a different layout
#   ./install-cli --form iso         what the shift probe would say
#   ./install-cli --seconds 3        a different rotation beat
#   ./install-cli --census 3         how long the census pretends to take
#   ./install-cli --fake-disks       THE DEMO: the whole flow, faked end to
#                                    end — canned disks, a canned census
#                                    reveal, and a simulated install bar that
#                                    runs to "restarting into Golem" without
#                                    touching a disk
#   ./install-cli --write FILE       write the keyboard+language nix module
#   ./install-cli --out FILE         write the answers for golem-install
#   ./install-cli --no-loadkeys      do not touch the console keymap
#   GOLEM_KEYBOARDS=FILE ./install-cli   use a rendered layout table
#   GOLEM_REHEARSE=1 ./install-cli       hand golem-install --rehearse: the
#                                        whole flow, nothing written, a
#                                        bundle left for the dev box (wins
#                                        over GOLEM_LAB — see step_go)
#   ./install-cli --ascii            Latin names only (see THE SHAPING NOTE)
#
#   dump modes, for looking at one state without a TTY:
#   ./install-cli --dump invite   --rot 4
#   ./install-cli --dump filter   --query esp
#   ./install-cli --dump keyboard --lang de
#   ./install-cli --dump layouts  --lang de --form iso
#   ./install-cli --dump done     --lang de
#   ./install-cli --dump settings --kb colemak   what gets written, in nix
#   ./install-cli --check                        every language resolves to
#                                                a real layout row
#
#   keys, step 1:  ENTER   opens the list, and takes the highlighted row
#                  type    filters as you go
#                  ↑ ↓     move through the matches
#                  BACKSP  erase; on an empty query, back to the invitation
#                  ESC     back to the invitation · q on the invitation quits
#
#   keys, step 2:  type    goes into the echo box, to compare with your keys
#                  ENTER   the layout is right — take it and go on
#                  ↓       it is not — open the list of layouts
#                  BACKSP  erase a character · ESC empties the box
# ─────────────────────────────────────────────────────────────────────────
set -uo pipefail

# Endonyms are the whole point of this screen, so the script must be able to
# count characters rather than bytes. If the medium has no UTF-8 locale the
# filter still works — only the column alignment goes ragged.
[[ ${LC_ALL:-} == *UTF-8* || ${LANG:-} == *UTF-8* ]] || export LC_ALL=C.UTF-8

# ══ LOOK ═════════════════════════════════════════════════════════════════
#
# The palette is census-mock's, unchanged: a NEUTRAL RAMP plus ONE accent,
# and the accent only ever appears where it means something — what has focus
# and what a thing is called. Colour used for decoration is what makes a
# terminal look amateur. Values are the brightest ink on screen because they
# are the content; everything else is scaffolding pointing at them.
esc=$'\e'
NORM="$esc[0m"; BOLD="$esc[1m"
fg() { printf '%s' "$esc[38;5;$1m"; }

C_ASK=$(fg 252)         # the question — brightest, it is the content
C_LABEL=$(fg 244)       # what an answered line is called
C_VALUE=$(fg 252)       # what it was answered with
C_DIM=$(fg 240)         # aliases, codes, "no match"
C_ACCENT=$(fg 180)      # the one accent: what is highlighted right now
C_ACCENT_TX="$(fg 223)$BOLD"
C_TICK=$(fg 137)        # one step down the same accent ramp, never a hue

# Two SEMANTIC hues, used only where meaning demands a colour of its own and
# the single accent would blur two different messages into one. Kept muted
# so they read as signal, not decoration — a neon red on a grey screen is
# the amateur look the palette note warns about.
C_RED=$(fg 174)         # SOMETHING IS WRONG OR IRREVERSIBLE — the two things
                        # that stop you: the disk that will be erased, and a
                        # field error like "the passwords didn't match". Both
                        # are the same signal, "attention, this is not right",
                        # so both are red. Nothing merely quiet ever is.
C_YELLOW=$(fg 179)      # the recognition verdict — the drivers count. Its
                        # own hue because it is the screen's headline number
                        # and must not be mistaken for the amber "in focus".

TICK='·'                # not a checkmark: this is a transcript, not a form
CARET='›'

hide_cursor() { [ "$TTY" = yes ] && printf '%s[?25l' "$esc"; }
show_cursor() { [ "$TTY" = yes ] && printf '%s[?25h' "$esc"; }

# ══ WIDTH ════════════════════════════════════════════════════════════════
#
# census-mock could not do this and said so: its grid wrote one cell per
# code point, so हिन्दी (6 code points, 5 columns) shifted the right-hand
# frame by a cell. Here the only thing that needs a width is the pad between
# the endonym column and the one after it, so it is ~20 lines instead of a
# rewrite of the renderer. Nonspacing marks count 0, CJK/Hangul count 2.
dwidth() {
  local s=$1 n=0 i c cp
  for (( i = 0; i < ${#s}; i++ )); do
    c=${s:i:1}
    printf -v cp '%d' "'$c" 2>/dev/null || { n=$(( n + 1 )); continue; }
    if   (( cp < 128 )); then n=$(( n + 1 ))
    elif (( (cp >= 0x0300 && cp <= 0x036F) || (cp >= 0x0591 && cp <= 0x05BD) ||
            (cp == 0x05BF) || (cp >= 0x05C1 && cp <= 0x05C2) ||
            (cp >= 0x064B && cp <= 0x065F) || cp == 0x0670 ||
            (cp >= 0x06D6 && cp <= 0x06ED) ||
            (cp >= 0x0900 && cp <= 0x0902) || cp == 0x093A || cp == 0x093C ||
            (cp >= 0x0941 && cp <= 0x0948) || cp == 0x094D ||
            (cp >= 0x0951 && cp <= 0x0957) ||
            cp == 0x09BC || (cp >= 0x09C1 && cp <= 0x09C4) || cp == 0x09CD ||
            cp == 0x0BC0 || cp == 0x0BCD ||
            (cp >= 0x0C3E && cp <= 0x0C40) || (cp >= 0x0C46 && cp <= 0x0C56) ||
            cp == 0x0E31 || (cp >= 0x0E34 && cp <= 0x0E3A) ||
            (cp >= 0x0E47 && cp <= 0x0E4E) )); then :
    elif (( (cp >= 0x1100 && cp <= 0x115F) || (cp >= 0x2E80 && cp <= 0xA4CF) ||
            (cp >= 0xAC00 && cp <= 0xD7A3) || (cp >= 0xF900 && cp <= 0xFAFF) ||
            (cp >= 0xFE30 && cp <= 0xFE6F) || (cp >= 0xFF00 && cp <= 0xFF60) ||
            (cp >= 0xFFE0 && cp <= 0xFFE6) || cp >= 0x20000 )); then n=$(( n + 2 ))
    else n=$(( n + 1 ))
    fi
  done
  printf '%d' "$n"
}

pad_to() {                       # $1 text, $2 columns
  local w; w=$(dwidth "$1")
  printf '%s' "$1"
  (( $2 > w )) && printf '%*s' "$(( $2 - w ))" ''
}

# ══ THE LANGUAGES ════════════════════════════════════════════════════════
#
# THE ENDONYM RULE, kept from census-mock: each language is printed the way
# its own speakers write it. No flags — a flag is a country, not a language,
# and there is no flag for Spanish that is not wrong for most of the people
# who speak it. No English names in the first column, because someone
# looking for Deutsch is looking for "Deutsch".
#
# What the chat form adds, and the list form could not: the SEARCH column.
# A stranger at this point is typing on an unknown keymap and cannot produce
# their own script — nobody types 日本語 to find 日本語. So every row also
# carries a Latin name, English aliases and its code, and the filter matches
# all of them. Type "jap", "nihon", "ja" or "日本" and you land on the same
