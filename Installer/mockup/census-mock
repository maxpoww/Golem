# ══ SCAFFOLDING ══════════════════════════════════════════════════════════

profile=acer; dump=no; FOCUS=""; scroll=0; SCREEN=census
LANG_SEL=0; KB_SEL=0; TILE_FOCUS=A
COLS=$(tput cols 2>/dev/null || echo 120)
ROWS=$(tput lines 2>/dev/null || echo 34)

while [ $# -gt 0 ]; do
  case "$1" in
    -p|--profile) profile="${2:?}"; shift 2 ;;
    --focus)      FOCUS="${2:?}"; shift 2 ;;
    --dump)       dump=yes; shift ;;
    --scroll)     scroll="${2:?}"; shift 2 ;;
    --screen)     SCREEN="${2:?}"; shift 2 ;;
    --lang)       LANG_SEL="${2:?}"; LANG_PICKED=yes; shift 2 ;;
    --kb)         KB_SEL="${2:?}"; KB_AUTO=no; shift 2 ;;
    --tile)       TILE_FOCUS="${2:?}"; shift 2 ;;
    --rot)        LANG_ROT="${2:?}"; shift 2 ;;   # which language the attract line is on
    --cols)       COLS="${2:?}"; shift 2 ;;
    --rows)       ROWS="${2:?}"; shift 2 ;;
    -h|--help)    sed -n '2,24p' "$0"; exit 0 ;;
    *) echo "census-mock: unknown argument '$1'" >&2; exit 2 ;;
  esac
done

(( COLS < 60 )) && { echo "census-mock: needs at least 60 columns" >&2; exit 1; }
(( ROWS < 20 )) && { echo "census-mock: needs at least 20 rows" >&2; exit 1; }

layout
build_pane < <(pane_a "$profile"); PANE_A=("${PANE[@]}")
build_pane < <(pane_b "$profile"); PANE_B=("${PANE[@]}")

TOP=0
VIS=$(( TILE_H - 2 ))
MAXTOP_A=$(( ${#PANE_A[@]} - VIS )); (( MAXTOP_A < 0 )) && MAXTOP_A=0
MAXTOP_B=$(( ${#PANE_B[@]} - VIS )); (( MAXTOP_B < 0 )) && MAXTOP_B=0
# The counter runs to the LONGER tile's limit; the shorter one clamps in
# compose. Stopping at the shorter one would make its extra rows unreachable.
MAXTOP=$MAXTOP_A; (( MAXTOP_B > MAXTOP )) && MAXTOP=$MAXTOP_B

# The rows no longer line up — the lists are their natural lengths — but the
# SECTIONS still pair off, and that pairing is what makes scrolling both at
# once mean anything: memory beside memory, graphics beside graphics. That
# is the invariant worth checking, and nothing in bash enforces it, so it
# gets checked rather than trusted.
check_sections() {
  local i a="" b=""
  for i in "${PANE_A[@]}"; do [ "${i:0:1}" = S ] && a+="${i:1}|"; done
  for i in "${PANE_B[@]}"; do [ "${i:0:1}" = S ] && b+="${i:1}|"; done
  # golem/machine are the two sides' names for the same first section —
  # what this is, facing what it will become.
  a="${a/#machine|/·|}"; b="${b/#golem|/·|}"
  [ "$a" = "$b" ] && return 0
  printf 'census-mock: sections do not pair up\n  Evaluation: %s\n  Directions: %s\n' \
    "${a%|}" "${b%|}" >&2
}
check_sections

# --scroll drives both tiles, so a scrolled frame can be inspected without
# driving the TUI by hand.
TOP=$(( scroll > MAXTOP ? MAXTOP : scroll ))

# One entry point, so the redraw loop never has to know which screen it is
# painting — the installer is a sequence of these and the loop stays fixed.
compose() {
  case "$SCREEN" in
    locale|language) compose_locale ;;
    *)               compose_census ;;
  esac
}

# THE BUTTON ROW IS FURNITURE. Three boxes in the same places on every
# screen, and only the middle word changes:
#   Reboot   always leaves, changing nothing. On every screen, so there is
#            never a moment where the way out is somewhere else.
#   <middle> the one thing this screen is for.
#   Device   the same unfinished feature, told the same truth throughout.
# Widths follow from the labels via the constant-padding rule in layout(),
# so a longer middle word just makes a wider middle box with the label still
# dead centre — nothing else on the row moves.
screen_buttons() {
  case "$SCREEN" in
    locale|language) LABELS=(Reboot Next Device);    HINT_PRIMARY=Next ;;
    *)               LABELS=(Reboot Install Device); HINT_PRIMARY=Install ;;
  esac
  layout
}
screen_buttons

lang_changed        # --lang alone should carry the keyboard with it
if [ "$dump" = yes ]; then compose; exit 0; fi

# TWO independent tracks, because they answer different questions.
#
#   tab / space / shift-tab   which button Enter would press
#   left / right              which tile the arrows scroll
#   up / down                 scroll it, always, from anywhere
#
# Folding the tiles into the tab cycle made scrolling conditional on
# having tabbed to the right place first — you had to navigate before you
# could read. Reading is the main thing this screen is for, so the arrows
# answer immediately and the button cycle stays out of their way.
cycle() {
  # From nothing, the first press reaches for the primary action rather
  # than for whichever button happens to be drawn leftmost — the guide
  # line has just told the user SPACE gets them started, so it had better.
  if [ -z "$FOCUS" ]; then FOCUS="$HINT_PRIMARY"; return; fi
  local i n=${#LABELS[@]}
  for i in "${!LABELS[@]}"; do [ "${LABELS[i]}" = "$FOCUS" ] && break; done
  FOCUS="${LABELS[$(( (i + $1 + n) % n ))]}"
}

cleanup() { tput cnorm 2>/dev/null; tput rmcup 2>/dev/null; stty echo 2>/dev/null; }
trap cleanup EXIT INT TERM
tput smcup 2>/dev/null; tput civis 2>/dev/null; stty -echo 2>/dev/null

while :; do
  # Home the cursor and overwrite; never clear. Every cell of every row is
  # painted each frame, so a clear erases nothing that is not about to be
  # rewritten — all it does is show an empty screen for however long the
  # compose takes, which is exactly the blink.
  printf '%s' "$esc[H"
  compose
  # A TIMED read only while the attract loop is running, so the rest of the
  # installer keeps the blocking one it had. read returns non-zero on the
  # timeout, and that is the whole clock: no background job, no sleep, no
  # second process to kill on the way out.
  if [ "$SCREEN" = locale ] && [ "$LANG_PICKED" = no ] && [ -z "$FOCUS" ]; then
    IFS= read -rsn1 -t "$ROT_SECONDS" key; rc=$?
    # read fails BOTH on timeout and on end-of-input, and they mean opposite
    # things: one is the beat, the other is no keyboard at all. Bash returns
    # >128 for a timeout, so tell them apart — otherwise a run with stdin
    # closed spins the rotation at full speed instead of stopping.
    if (( rc > 128 )); then
      LANG_ROT=$(( (LANG_ROT + 1) % ${#LANG_CODE[@]} ))
      continue
    elif (( rc != 0 )); then
      break
    fi
  else
    IFS= read -rsn1 key || break
  fi
  if [ "$key" = "$esc" ]; then IFS= read -rsn2 -t 0.01 rest || rest=""; key="$key$rest"; fi
  # TWO TRACKS, as everywhere else in this installer: the arrows drive the
  # tiles, SPACE drives the buttons, and neither waits for the other. Here
  # both tiles hold a list, so left/right says which one the arrows aim at —
  # the meaning the arrows had on the census screen, where there was only
  # ever one answer and so no need to ask.
  if [ "$SCREEN" = locale ] || [ "$SCREEN" = language ]; then
    case "$key" in
      "$esc[D") TILE_FOCUS=A ;;
      "$esc[C") TILE_FOCUS=B ;;
      "$esc[A")
        if [ "$TILE_FOCUS" = A ]; then
          (( LANG_SEL > 0 )) && { (( LANG_SEL-- )); LANG_PICKED=yes; lang_changed; }
        else
          (( KB_SEL > 0 )) && { (( KB_SEL-- )); KB_AUTO=no; }
        fi ;;
      "$esc[B")
        if [ "$TILE_FOCUS" = A ]; then
          (( LANG_SEL < ${#LANG_NAME[@]} - 1 )) && { (( LANG_SEL++ )); LANG_PICKED=yes; lang_changed; }
        else
          (( KB_SEL < ${#KB_NAME[@]} - 1 )) && { (( KB_SEL++ )); KB_AUTO=no; }
        fi ;;
      # A number printed beside an item is a promise that the key works. It
      # reaches the language list from anywhere and pulls focus back to it,
      # so the press is always visibly the thing that happened — a shortcut
      # that changed something off-screen would be worse than no shortcut.
      [1-9])
        nsel=$(( key - 1 ))
        if (( nsel < ${#LANG_NAME[@]} )); then
          TILE_FOCUS=A; LANG_SEL=$nsel; LANG_PICKED=yes; lang_changed
        fi ;;
      $'\t'|' ') cycle 1 ;;
      "$esc[Z")  cycle -1 ;;
      "")        [ "$FOCUS" = Next ] && { SCREEN=census; FOCUS=""; screen_buttons; }
                 [ "$FOCUS" = Reboot ] && break ;;
      q|"$esc")  break ;;
    esac
    continue
  fi
  case "$key" in
    $'\t'|' ') cycle 1 ;;
    "$esc[Z")  cycle -1 ;;
    # The arrows are not aimed at anything because there is only one thing
    # they could mean: both tiles move together, so no tile
    # selection is needed to disambiguate and none exists.
    "$esc[A")  (( TOP > 0 )) && (( TOP-- )) ;;
    "$esc[B")  (( TOP < MAXTOP )) && (( TOP++ )) ;;
    q|"$esc")  break ;;
    "")        [ "$FOCUS" = Reboot ] && break ;;
  esac
done
