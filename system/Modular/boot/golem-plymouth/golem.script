# Golem's boot bar — the OPTIONS status bar, at boot.
#
# Max, 2026-09-23: "show our bar everywhere" → then "get rid of the words, lets
# keep only the bar, and make it thicker." So: ONE thick accent bar filling on a
# dim track, centred, nothing else. No spinner, no logo, no service line — the
# bar IS the surface.
#
# The accent is the orange the surface actually shows (#AA5500 — the console's
# VGA fallback for fg 180; the tile is baked in boot/plymouth.nix); the track is
# a dim grey.

Window.SetBackgroundTopColor(0.0, 0.0, 0.0);
Window.SetBackgroundBottomColor(0.0, 0.0, 0.0);

screen_width  = Window.GetWidth();
screen_height = Window.GetHeight();

bar_width  = Math.Int(screen_width * 0.42);
# THICK (Max: "make it thicker", twice) — ~4% of the screen height, ~32px on an
# 800px panel, over double the installer block's ~15px.
bar_height = Math.Int(screen_height * 0.04);
if (bar_height < 18) bar_height = 18;
bar_x = Math.Int((screen_width  - bar_width)  / 2);
bar_y = Math.Int((screen_height - bar_height) / 2);   # centred on the thick bar

# ── the dim track: full width, always there ──────────────────────────────
track_image  = Image("track.png").Scale(bar_width, bar_height);
track_sprite = Sprite(track_image);
track_sprite.SetPosition(bar_x, bar_y, 1);

# ── the accent fill: grows left→right with boot progress ─────────────────
# STABLE (Max, 2026-09-23: "it flickers a little, lets try to make it stable"):
# Plymouth calls the progress function many times a second, mostly with the same
# rounded width. Rescaling + re-placing the sprite on every one of those was the
# churn that flickered — so we cache the last width and only touch the sprite
# when the bar has actually grown a pixel. The position is set ONCE, not per
# frame, so the sprite never moves.
fill_source = Image("accent.png");
fill_sprite = Sprite();
fill_sprite.SetPosition(bar_x, bar_y, 2);
last_w = -1;

fun draw_fill(fraction) {
  w = Math.Int(bar_width * fraction);
  if (w < 2) w = 2;
  if (w > bar_width) w = bar_width;
  if (w != last_w) {
    last_w = w;
    fill_sprite.SetImage(fill_source.Scale(w, bar_height));
  }
}
draw_fill(0.0);

Plymouth.SetBootProgressFunction(
  fun (duration, progress) {
    draw_fill(progress);
  });

# On quit, fade the bar out so the handoff to the compositor is clean.
Plymouth.SetQuitFunction(
  fun () {
    fill_sprite.SetOpacity(0);
    track_sprite.SetOpacity(0);
  });
