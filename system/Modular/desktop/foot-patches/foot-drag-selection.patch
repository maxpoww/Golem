+/*
+ * Golem: the selection as a drag source.
+ *
+ * Upstream foot only takes drops. Here a press on selected text that then
+ * travels starts a drag of that text — into an editor, a browser field, the
+ * card — always as a COPY: the terminal's text stays where it is.
+ */
+
+bool
+selection_is_at(const struct terminal *term, int col, int row)
+{
+    if (term->selection.ongoing ||
+        term->selection.coords.end.row < 0 ||
+        col < 0 || col >= term->cols ||
+        row < 0 || row >= term->rows)
+    {
+        return false;
+    }
+
+    const struct row *r = grid_row_in_view(term->grid, row);
+    return r != NULL && r->cells[col].attrs.selected;
+}
+
+void
+selection_drag_reset(struct seat *seat)
+{
+    seat->drag.pending = false;
+    seat->drag.term = NULL;
+
+    if (seat->drag.icon.viewport != NULL) {
+        wp_viewport_destroy(seat->drag.icon.viewport);
+        seat->drag.icon.viewport = NULL;
+    }
+    if (seat->drag.icon.surf != NULL) {
+        wl_surface_destroy(seat->drag.icon.surf);
+        seat->drag.icon.surf = NULL;
+    }
+
+    if (seat->drag.source != NULL) {
+        wl_data_source_destroy(seat->drag.source);
+        seat->drag.source = NULL;
+    }
+
+    free(seat->drag.text);
+    seat->drag.text = NULL;
+}
+
+static void
+drag_target(void *data, struct wl_data_source *wl_data_source,
+            const char *mime_type)
+{
+}
+
+static void
+drag_send(void *data, struct wl_data_source *wl_data_source,
+          const char *mime_type, int32_t fd)
+{
+    struct seat *seat = data;
+    send_clipboard_or_primary(seat, fd, seat->drag.text, "drag");
+}
+
+static void
+drag_cancelled(void *data, struct wl_data_source *wl_data_source)
+{
+    struct seat *seat = data;
+    if (seat->drag.source == wl_data_source)
+        selection_drag_reset(seat);
+    else
+        wl_data_source_destroy(wl_data_source);
+}
+
+static void
+drag_drop_performed(void *data, struct wl_data_source *wl_data_source)
+{
+}
+
+static void
+drag_finished(void *data, struct wl_data_source *wl_data_source)
+{
+    /* The target has read what it wanted: nothing more to serve */
+    drag_cancelled(data, wl_data_source);
+}
+
+static void
+drag_action(void *data, struct wl_data_source *wl_data_source,
+            uint32_t dnd_action)
+{
+}
+
+static const struct wl_data_source_listener drag_source_listener = {
+    .target = &drag_target,
+    .send = &drag_send,
+    .cancelled = &drag_cancelled,
+    .dnd_drop_performed = &drag_drop_performed,
+    .dnd_finished = &drag_finished,
+    .action = &drag_action,
+};
+
+bool
+selection_drag_begin(struct seat *seat, struct terminal *term, uint32_t serial)
+{
+    if (seat->data_device == NULL || term->wl->data_device_manager == NULL)
+        return false;
+
+    char *text = selection_to_text(term);
+    if (text == NULL || text[0] == '\0') {
+        free(text);
+        return false;
+    }
+
+    selection_drag_reset(seat);
+
+    struct wl_data_source *source =
+        wl_data_device_manager_create_data_source(term->wl->data_device_manager);
+
+    if (source == NULL) {
+        LOG_ERR("failed to create a data source for the drag");
+        free(text);
+        return false;
+    }
+
+    wl_data_source_offer(source, mime_type_map[DATA_OFFER_MIME_TEXT_UTF8]);
+    wl_data_source_offer(source, mime_type_map[DATA_OFFER_MIME_TEXT_PLAIN]);
+    wl_data_source_offer(source, mime_type_map[DATA_OFFER_MIME_TEXT_TEXT]);
+    wl_data_source_offer(source, mime_type_map[DATA_OFFER_MIME_TEXT_STRING]);
+    wl_data_source_offer(source, mime_type_map[DATA_OFFER_MIME_TEXT_UTF8_STRING]);
+    wl_data_source_add_listener(source, &drag_source_listener, seat);
+
+    if (wl_data_source_get_version(source) >= 3) {
+        wl_data_source_set_actions(
+            source, WL_DATA_DEVICE_MANAGER_DND_ACTION_COPY);
+    }
+
+    seat->drag.source = source;
+    seat->drag.text = text;
+
+    /* What is seen under the pointer: the text itself (its first line,
+     * and not a whole screenful of it). A surface of its own that the
+     * compositor carries; it gets its picture once it has that role. */
+    seat->drag.icon.surf = wl_compositor_create_surface(term->wl->compositor);
+    if (seat->drag.icon.surf != NULL && term->wl->viewporter != NULL) {
+        seat->drag.icon.viewport = wp_viewporter_get_viewport(
+            term->wl->viewporter, seat->drag.icon.surf);
+    }
+
+    /* The compositor takes the pointer from here on (we get a
+     * pointer-leave, which also forgets the held button) */
+    wl_data_device_start_drag(
+        seat->data_device, source, term->window->surface.surf,
+        seat->drag.icon.surf, serial);
+
+    if (seat->drag.icon.surf != NULL) {
+        enum { DRAG_ICON_CHARS = 48 };
+        char32_t *wide = ambstoc32(text);
+
+        if (wide != NULL) {
+            char32_t shown[DRAG_ICON_CHARS + 2];
+            size_t n = 0;
+            const char32_t *c = wide;
+
+            while (*c == U' ' || *c == U'\t' || *c == U'\n' || *c == U'\r')
+                c++;
+            while (*c != U'\0' && *c != U'\n' && *c != U'\r' &&
+                   n < DRAG_ICON_CHARS)
+            {
+                shown[n++] = *c == U'\t' ? U' ' : *c;
+                c++;
+            }
+
+            /* More than is shown: say so */
+            while (*c == U'\n' || *c == U'\r' || *c == U' ')
+                c++;
+            if (*c != U'\0')
+                shown[n++] = U'…';
+            shown[n] = U'\0';
+
+            /* Beside the pointer, not under it: it must not hide where
+             * the text is about to land */
+            if (wl_surface_get_version(seat->drag.icon.surf) >= 5)
+                wl_surface_offset(seat->drag.icon.surf, 14, 14);
+
+            if (n == 0 || !render_drag_icon(term, &seat->drag.icon, shown)) {
+                /* No picture: the drag itself is as good without one */
+                LOG_DBG("no drag icon");
+            }
+            free(wide);
+        }
+    }
+    return true;
+}
