+/*
+ * Golem: what a drag of the selection looks like under the pointer: the
+ * text itself, in the terminal's font, on a plate in the terminal's own
+ * colours turned over (ink for paper), the way a selection reads.
+ */
+bool
+render_drag_icon(struct terminal *term, const struct wayl_surface *surf,
+                 const char32_t *text)
+{
+    struct fcft_font *font = term->fonts[0];
+    if (font == NULL || surf->surf == NULL)
+        return false;
+
+    const size_t len = c32len(text);
+    if (len == 0)
+        return false;
+
+    struct fcft_text_run *text_run = NULL;
+    const struct fcft_glyph **glyphs = NULL;
+    const struct fcft_glyph *_glyphs[len];
+    size_t glyph_count = 0;
+
+    if (fcft_capabilities() & FCFT_CAPABILITY_TEXT_RUN_SHAPING) {
+        text_run = fcft_rasterize_text_run_utf32(
+            font, len, text, term->font_subpixel);
+
+        if (text_run != NULL) {
+            glyphs = text_run->glyphs;
+            glyph_count = text_run->count;
+        }
+    }
+
+    if (glyphs == NULL) {
+        for (size_t i = 0; i < len; i++) {
+            const struct fcft_glyph *glyph = fcft_rasterize_char_utf32(
+                font, text[i], term->font_subpixel);
+
+            if (glyph != NULL)
+                _glyphs[glyph_count++] = glyph;
+        }
+        glyphs = _glyphs;
+    }
+
+    int text_width = 0;
+    for (size_t i = 0; i < glyph_count; i++)
+        text_width += glyphs[i]->advance.x;
+
+    /* A size the surface's scale can show exactly: whole logical pixels,
+     * taken back to the buffer's */
+    const float scale = term->scale;
+    const int pad = (int)roundf(6 * scale);
+    const int font_height = max(font->height, font->ascent + font->descent);
+    const int logical_width = (int)ceilf((text_width + 2 * pad) / scale);
+    const int logical_height = (int)ceilf((font_height + 2 * pad) / scale);
+    const int width = (int)roundf(logical_width * scale);
+    const int height = (int)roundf(logical_height * scale);
+
+    struct buffer *buf = shm_get_buffer(term->render.chains.url, width, height);
+    if (buf == NULL) {
+        fcft_text_run_destroy(text_run);
+        return false;
+    }
+
+    const bool gamma_correct = wayl_do_linear_blending(term->wl, term->conf);
+    pixman_color_t bg = color_hex_to_pixman_with_alpha(
+        term->colors.fg, 0xeeee, gamma_correct);
+    pixman_color_t fg = color_hex_to_pixman(term->colors.bg, gamma_correct);
+
+    pixman_image_fill_rectangles(
+        PIXMAN_OP_SRC, buf->pix[0], &bg, 1,
+        &(pixman_rectangle16_t){0, 0, width, height});
+
+    pixman_image_t *src = pixman_image_create_solid_fill(&fg);
+    const int baseline =
+        (int)roundf((height - font_height) / 2.f) + font->ascent;
+    int x = pad;
+
+    for (size_t i = 0; i < glyph_count; i++) {
+        const struct fcft_glyph *glyph = glyphs[i];
+
+        if (unlikely(glyph->is_color_glyph)) {
+            pixman_image_composite32(
+                PIXMAN_OP_OVER, glyph->pix, NULL, buf->pix[0], 0, 0, 0, 0,
+                x + glyph->x, baseline - glyph->y,
+                glyph->width, glyph->height);
+        } else {
+            pixman_image_composite32(
+                PIXMAN_OP_OVER, src, glyph->pix, buf->pix[0], 0, 0, 0, 0,
+                x + glyph->x, baseline - glyph->y,
+                glyph->width, glyph->height);
+        }
+
+        x += glyph->advance.x;
+    }
+
+    fcft_text_run_destroy(text_run);
+    pixman_image_unref(src);
+
+    wayl_surface_scale(term->window, surf, buf, scale);
+    wl_surface_attach(surf->surf, buf->wl_buf, 0, 0);
+    wl_surface_damage_buffer(surf->surf, 0, 0, width, height);
+    wl_surface_set_opaque_region(surf->surf, NULL);
+    wl_surface_commit(surf->surf);
+    return true;
+}
