+/*
+ * Descriptors the broker keeps for its own work: a memfd per large message,
+ * a pidfd per peer, the odd timer. Connections are never let eat into them,
+ * because once they are gone any of those allocations fails, and a failure
+ * there is fatal.
+ */
+#define LISTENER_FD_HEADROOM 64
+
+static unsigned long listener_fds_open(void) {
+        DIR *d = opendir("/proc/self/fd");
+        unsigned long n = 0;
+
+        if (!d)
+                return (unsigned long)-1;
+        while (readdir(d))
+                ++n;
+        closedir(d);
+        return n;
+}
+
+static bool listener_out_of_headroom(void) {
+        struct rlimit rl;
+        unsigned long n;
+
+        if (getrlimit(RLIMIT_NOFILE, &rl) < 0)
+                return false;
+        n = listener_fds_open();
+        if (n == (unsigned long)-1)
+                return true;
+        return n + LISTENER_FD_HEADROOM >= rl.rlim_cur;
+}
+
+/* Take the pending connection and close it at once: the client is refused,
+ * the backlog does not keep waking us. */
+static void listener_refuse(Listener *listener) {
+        int fd;
+
+        if (listener->spare_fd >= 0)
+                listener->spare_fd = c_close(listener->spare_fd);
+        fd = accept4(listener->socket_fd, NULL, NULL, SOCK_CLOEXEC | SOCK_NONBLOCK);
+        if (fd >= 0)
+                c_close(fd);
+        else if (errno == EAGAIN)
+                dispatch_file_clear(&listener->socket_file, EPOLLIN);
+        listener->spare_fd = open("/dev/null", O_RDONLY | O_CLOEXEC);
+        if (listener->n_refused++ == 0 && listener->bus && listener->bus->log) {
+                log_append_here(listener->bus->log, LOG_WARNING, 0, NULL);
+                log_commitf(listener->bus->log, "Out of file descriptors: a new connection was refused rather than the bus exiting; something is leaking connections.");
+        }
+}
 #include "bus/listener.h"
 #include "bus/peer.h"
 #include "bus/policy.h"
