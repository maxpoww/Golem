+// Shift a floating window by `delta` when its screen moves or its workspace
+// changes screens. Through the layout, not just its box: the floating layout
+// keeps its own copy of the box (`lastBox`), and leaving fullscreen puts the
+// window back there. Shifting only the box left that copy on the old screen,
+// so a window made fullscreen on a screen that was then unplugged came back
+// off-screen when it left fullscreen. (Not for a maximized window: its box is
+// the work area, and remembering that would bring it back screen-sized.)
+static void shiftFloatingWindow(PHLWINDOW w, const Vector2D& delta) {
+    const auto TARGET = w->layoutTarget();
+    if (!TARGET)
+        return;
+    const auto SPACE = TARGET->space();
+    const auto ALGO  = SPACE ? SPACE->algorithm() : nullptr;
+    if (ALGO && TARGET->floating() && !(TARGET->fullscreenMode() & FSMODE_MAXIMIZED))
+        ALGO->moveTarget(delta, TARGET);
+    else
+        TARGET->setPositionGlobal(TARGET->position().translate(delta));
+}
