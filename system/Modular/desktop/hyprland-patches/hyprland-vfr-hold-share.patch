@@ -114,8 +114,13 @@ eScreenshareError CScreenshareFrame::share(SP<IHLBuffer> buffer, const CRegion&
 
     if (m_session->m_type == SHARE_MONITOR || m_session->m_type == SHARE_REGION) {
         const auto PMONITOR = m_session->monitor();
-        if (PMONITOR)
+        if (PMONITOR) {
+            // vfr hold (Golem): this damage is the share's own, not the screen changing
+            const bool REAL = PMONITOR->m_damage.hasChanged() && !g_vfrHoldShareOnly.contains(PMONITOR.get());
             PMONITOR->addDamage(PMONITOR->resources()->pendingMirrorFBDamage());
+            if (!REAL)
+                g_vfrHoldShareOnly.insert(PMONITOR.get());
+        }
     }
 
     // schedule a frame so that when a screenshare starts it isn't black until the output is updated
