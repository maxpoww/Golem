                 w != pIgnoreWindow && !isShadowedByModal(w)) {
                 CBox box = (properties & Desktop::View::USE_PROP_TILED) ? w->getWindowBoxUnified(properties) : CBox{w->m_position, w->m_size};
-                if ((properties & Desktop::View::INPUT_EXTENTS) && BORDER_GRAB_AREA > 0 && !w->isX11OverrideRedirect()) {
+                // Golem: a PSEUDO-tiled window is hit where it is drawn, not across
+                // its whole tile. The tile is the room the layout gave it; the
+                // window sits smaller inside, and what shows around it is the
+                // desktop — which must answer the pointer there (its icons, a
+                // click on the wallpaper), as it does in any gap. The border
+                // grab area still surrounds the window itself, so its edges
