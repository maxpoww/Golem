+// One-empty swipe targets (gestures:workspace_swipe_one_empty): from an
+// occupied workspace the swipe steps to the raw neighbor, so a single empty
+// workspace is always reachable — but from an empty workspace it jumps
+// straight to the nearest occupied one in that direction. Returns the current
+// workspace id when there is nothing further in that direction; the existing
+// delta clamps treat that as the end of the strip.
+static WORKSPACEID oneEmptySwipeTarget(const PHLWORKSPACE& current, const PHLMONITOR& monitor, int dir) {
+    if (current->getWindows() > 0)
+        return getWorkspaceIDNameFromString(dir > 0 ? "r+1" : "r-1").id;
+
+    WORKSPACEID nearest = WORKSPACE_INVALID;
+    for (auto const& w : g_pCompositor->getWorkspaces()) {
+        if (w->m_monitor != monitor || g_pCompositor->isWorkspaceSpecial(w->m_id) || w->getWindows() == 0)
+            continue;
+        if (dir > 0 ? w->m_id <= current->m_id : w->m_id >= current->m_id)
+            continue;
+        if (nearest == WORKSPACE_INVALID || (dir > 0 ? w->m_id < nearest : w->m_id > nearest))
+            nearest = w->m_id;
+    }
+
+    return nearest == WORKSPACE_INVALID ? current->m_id : nearest;
+}
