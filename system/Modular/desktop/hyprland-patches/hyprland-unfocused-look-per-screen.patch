+// Golem: every screen keeps its own focus look. The unfocused look (the
+// inactive border, and the title bar drawn from it; the dim; the inactive
+// opacity and shadow) marks the windows BESIDE the focused one, on its
+// screen. A window on another screen keeps the focused look: working on the
+// laptop does not darken the TV (Max, 2026-11-10).
+bool CWindow::looksActive() {
+    if (m_self == Desktop::focusState()->window())
+        return true;
+    const auto HERE = Desktop::focusState()->looksMonitor();
+    const auto MINE = m_workspace ? m_workspace->m_monitor.lock() : m_monitor.lock();
+    return HERE && MINE && MINE != HERE;
+}
