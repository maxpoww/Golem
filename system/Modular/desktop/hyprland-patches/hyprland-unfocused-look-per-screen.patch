+// The focused window's screen; with no window focused, the focused screen.
+PHLMONITOR CFocusState::looksMonitor() {
+    if (const auto W = m_focusWindow.lock(); W && W->m_workspace && W->m_workspace->m_monitor)
+        return W->m_workspace->m_monitor.lock();
+    return m_focusMonitor.lock();
+}
+
+// The focus went to another screen: every window's look is redone. The ones
+// on the screen left keep the focused look, the ones beside the new focus
+// take the unfocused one. Within one screen only the two windows involved
+// change, as before.
+void CFocusState::refreshScreenLooks() {
+    const auto HERE = looksMonitor();
+    if (HERE == m_looksMonitor.lock())
+        return;
+    m_looksMonitor = HERE;
+    g_pCompositor->updateAllWindowsAnimatedDecorationValues();
+}
