+// gestures:workspace_swipe_bound — whether `target` lies outside the screen's
+// own workspaces: those bound by a workspace rule to the same monitor as the
+// workspace the swipe began on (none bound: no limit, as upstream). Golem
+// gives every screen its own block of workspaces (hyprland.lua, SCREENS); the
+// swipe walks that block only, also while a screen that is gone has its
+// workspaces shown on another one.
+static bool outsideSwipeBound(const PHLWORKSPACE& begin, WORKSPACEID target) {
+    static auto PSWIPEBOUND = CConfigValue<Config::INTEGER>("gestures:workspace_swipe_bound");
+    if (!*PSWIPEBOUND || !begin || target == WORKSPACE_INVALID || target == begin->m_id)
+        return false;
+    const auto HERE = Config::workspaceRuleMgr()->getBoundMonitorStringForWS(std::to_string(begin->m_id));
+    return Config::workspaceRuleMgr()->getBoundMonitorStringForWS(std::to_string(target)) != HERE;
+}
