# desktop/app-setup — an app the owner installs arrives with the SYSTEM it
# needs (2026-10-13; GolemModules.md's rule 2: "more than apps").
#
# A package is not always the whole thing. Steam without 32-bit graphics and
# its udev rules starts and finds no controller; Docker's client without the
# daemon and the group says "permission denied"; virt-manager with no
# libvirtd lists nothing; LocalSend behind the firewall sees nobody. A forum
# thread fixes each of these one answer at a time. Here it is written once:
# when a program is among the owner's installed apps, the system side it
# needs is switched on in the SAME rebuild that installs it — whether it came
# from a module's Apply or from a drag into the grid.
#
# How it knows: the dock's installs are home packages (hosts/target/apps.nix,
# generated by waverunner-apply from packages.list). This leaf looks at their
# names. Nothing is added to a machine that did not ask: every line below is
# off until its program is there, and goes away with it.
#
# The rule for a new line: it is what the upstream/NixOS documentation says
# the program needs to WORK (a service, a group, a port, a device rule) —
# never a preference, never tuning. One entry per program, and the desktop
# matrix proves both halves (off on a clean machine, on with the program).
{ config, lib, pkgs, ... }:

let
  owner = config.golem.owner;
  installed = map lib.getName config.home-manager.users.${owner}.home.packages;
  has = name: builtins.elem name installed;
  any = names: lib.any has names;

  games = [ "steam" "lutris" "heroic" "bottles" ];
  machines = [ "virt-manager" "gnome-boxes" ];
in
{
  # ── Games ────────────────────────────────────────────────────────────────
  # Steam is a system program on NixOS: its 32-bit runtime, its udev rules
  # and (for Remote Play / local transfers) its ports come with the module.
  programs.steam = lib.mkIf (has "steam") {
    enable = true;
    remotePlay.openFirewall = true;
    localNetworkGameTransfers.openFirewall = true;
  };
  # Controllers and VR headsets are let through to the session.
  hardware.steam-hardware.enable = lib.mkIf (any games) true;
  # Windows games and old Linux ones are 32-bit: they need 32-bit graphics.
  hardware.graphics.enable32Bit = lib.mkIf (any (games ++ [ "wine" "wine-wow64" "winetricks" ])) true;
  # GameMode's daemon needs its polkit rules to be allowed to do anything.
  programs.gamemode.enable = lib.mkIf (any (games ++ [ "gamemode" ])) true;
  # Gamescope needs its capability to run with real-time priority.
  programs.gamescope.enable = lib.mkIf (has "gamescope") true;
  # Sunshine captures the screen and makes input devices: both privileged.
  services.sunshine = lib.mkIf (has "sunshine") {
    enable = true;
    capSysAdmin = true;
    openFirewall = true;
  };

  # ── Containers and machines ──────────────────────────────────────────────
  virtualisation.docker.enable = lib.mkIf (has "docker") true;
  # Distrobox and Podman Desktop need a container engine; Podman when there
  # is no Docker to use.
  virtualisation.podman.enable = lib.mkIf (any [ "podman-desktop" "distrobox" ] && !has "docker") true;
  virtualisation.libvirtd.enable = lib.mkIf (any machines) true;
  programs.virt-manager.enable = lib.mkIf (has "virt-manager") true;

  users.users.${owner}.extraGroups =
    lib.optional (has "docker") "docker"
    ++ lib.optionals (any machines) [ "libvirtd" "kvm" ];

  # Programs built for other Linux systems (an editor's downloaded language
  # server, a vendor's binary) find their loader.
  programs.nix-ld.enable = lib.mkIf (has "nix-ld") true;

  # ── Networks ─────────────────────────────────────────────────────────────
  # A VPN's app talks to its daemon; without the daemon it connects to nothing.
  services.mullvad-vpn.enable = lib.mkIf (any [ "mullvad-vpn" "mullvad" ]) true;
  services.tailscale.enable = lib.mkIf (has "tailscale") true;
  # The application firewall's window is a front end to its daemon.
  services.opensnitch.enable = lib.mkIf (has "opensnitch-ui") true;

  # Sharing on the local network only works when the others can reach us.
  networking.firewall.allowedTCPPorts =
    lib.optional (has "localsend") 53317
    ++ lib.optional (has "syncthing") 22000;
  networking.firewall.allowedUDPPorts =
    lib.optional (has "localsend") 53317
    ++ lib.optionals (has "syncthing") [ 22000 21027 ];

  # ── Devices ──────────────────────────────────────────────────────────────
  # Hardware wallets are USB devices the owner must be allowed to open.
  hardware.ledger.enable = lib.mkIf (has "ledger-live-desktop") true;
  services.trezord.enable = lib.mkIf (has "trezor-suite") true;
  # A drawing tablet's driver is a user service with its own device rules.
  hardware.opentabletdriver.enable = lib.mkIf (has "opentabletdriver") true;

  # ── Local AI ─────────────────────────────────────────────────────────────
  # Ollama's command is a client: the models run in its service.
  services.ollama.enable = lib.mkIf (has "ollama") true;

  # ── Accessibility ────────────────────────────────────────────────────────
  # The screen reader needs the accessibility bus and a speech service.
  services.orca.enable = lib.mkIf (has "orca") true;
  services.speechd.enable = lib.mkIf (any [ "orca" "speechd" "speech-dispatcher" ]) true;
}
