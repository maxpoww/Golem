result
result-*
*.qcow2
# Per-VM EFI variable store written by run-vm.sh --uefi: the firmware
# stamps the machine's boot entry into it, so it is state, not source.
ovmf-vars.fd

# autonomous loop transcripts (2hs.sh) — two runs flagged these as homeless
run.log
run.err
raw.jsonl

# Rust build output (golem-connectd) — ~5k files, regenerated by cargo.
# The daemon's identity (private key, device id, pinned peer certs) is not
# here to ignore: it lives in ~/.local/share/golem-connectd/.
# hosts/target/ is NOT build output — it is the installed-Golem host shape
# (spec §6), and the per-machine files the installer drops there must be
# committable in the seeded checkout.
target/
!hosts/target/
